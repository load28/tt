{
  "//": [
    "tt 규칙 소스 — build.mjs가 vendored TypeScript 문법에 짜 넣어",
    "syntaxes/tt.tmLanguage.json을 생성한다. 직접 tt.tmLanguage.json을",
    "고치지 말 것 (테스트가 생성물 최신성을 검사한다).",
    "",
    "splices: TypeScript repository 항목 이름 -> 그 항목의 patterns 맨 앞에",
    "끼워 넣을 include 목록. TextMate는 같은 오프셋에서 매치가 겹치면 먼저",
    "나열된 규칙이 이기므로, 맨 앞 삽입으로 tt 규칙이 TS 규칙보다 우선한다.",
    "",
    "repository: tt 고유 규칙. 이름은 반드시 tt- 접두사 (TS 항목과의 충돌을",
    "build.mjs가 검사한다). TS 유래 개념은 .ts 스코프를 재사용해 테마 호환을",
    "지키고, tt 고유 개념만 .tt 스코프를 쓴다."
  ],
  "splices": {
    "statements": ["#tt-statement"],
    "expression": ["#tt-expression"],
    "expression-operators": ["#tt-pipeline-operator"],
    "function-parameters-body": ["#tt-val-parameter"],
    "expression-inside-possibly-arrow-parens": ["#tt-val-parameter"],
    "paren-expression": ["#tt-val-parameter"],
    "for-loop:2": ["#tt-val-declaration-modifier"]
  },
  "repository": {
    "tt-statement": {
      "patterns": [
        { "include": "#tt-val-declaration-modifier" },
        { "include": "#tt-variant-declaration" },
        { "include": "#tt-if-let" },
        { "include": "#tt-let-else" },
        { "include": "#tt-catch-val-parameters" }
      ]
    },
    "tt-expression": {
      "patterns": [
        { "include": "#tt-match-expression" },
        { "include": "#tt-result-expression" },
        { "include": "#tt-flow-head" },
        { "include": "#tt-try-expression" }
      ]
    },
    "tt-val-declaration-modifier": {
      "match": "(?<![_$[:alnum:]])(?:(?<=\\.\\.\\.)|(?<!\\.))(val)\\s+(?=(?:const|let|var)(?![_$[:alnum:]]))",
      "captures": { "1": { "name": "storage.modifier.val.tt" } }
    },
    "tt-catch-val-parameters": {
      "name": "meta.catch.parameters.tt",
      "begin": "(?<![_$[:alnum:]])(catch)\\s*(\\()(?=[^)]*(?<![_$[:alnum:]])val\\s)",
      "beginCaptures": {
        "1": { "name": "keyword.control.trycatch.ts" },
        "2": { "name": "punctuation.definition.parameters.begin.ts" }
      },
      "end": "\\)",
      "endCaptures": { "0": { "name": "punctuation.definition.parameters.end.ts" } },
      "patterns": [
        { "include": "#comment" },
        { "include": "#tt-val-parameter" },
        { "include": "#parameter-name" },
        { "include": "#parameter-type-annotation" }
      ]
    },
    "tt-val-parameter": {
      "match": "(?<![_$[:alnum:]])(?:(?<=\\.\\.\\.)|(?<!\\.))(val)(?=\\s+(?!as(?![_$[:alnum:]])|satisfies(?![_$[:alnum:]])|is(?![_$[:alnum:]])|in(?![_$[:alnum:]])|of(?![_$[:alnum:]])|instanceof(?![_$[:alnum:]])|keyof(?![_$[:alnum:]]))[$_[:alpha:]{\\[])",
      "captures": { "1": { "name": "storage.modifier.val.tt" } }
    },
    "tt-variant-declaration": {
      "name": "meta.variant.declaration.tt",
      "begin": "(?<![_$[:alnum:]])(?:\\b(export)\\s+)?\\b(variant)[ \\t]+([$_[:alpha:]][$_[:alnum:]]*)(?=\\s*(?:<|\\{))",
      "beginCaptures": {
        "1": { "name": "keyword.control.export.ts" },
        "2": { "name": "storage.type.variant.tt" },
        "3": { "name": "entity.name.type.variant.tt" }
      },
      "end": "(?<=\\})|(?=[^\\s<{])",
      "patterns": [
        { "include": "#comment" },
        { "include": "#type-parameters" },
        { "include": "#tt-variant-body" }
      ]
    },
    "tt-variant-body": {
      "name": "meta.variant.body.tt",
      "begin": "\\{",
      "end": "\\}",
      "beginCaptures": { "0": { "name": "punctuation.definition.block.ts" } },
      "endCaptures": { "0": { "name": "punctuation.definition.block.ts" } },
      "patterns": [
        { "include": "#comment" },
        {
          "name": "meta.variant.case.payload.tt",
          "begin": "([$_[:alpha:]][$_[:alnum:]]*)\\s*(\\()",
          "beginCaptures": {
            "1": { "name": "variable.other.enummember.ts" },
            "2": { "name": "punctuation.definition.parameters.begin.ts" }
          },
          "end": "\\)",
          "endCaptures": { "0": { "name": "punctuation.definition.parameters.end.ts" } },
          "patterns": [
            { "include": "#comment" },
            {
              "begin": "([$_[:alpha:]][$_[:alnum:]]*)\\s*(\\??)\\s*(:)",
              "beginCaptures": {
                "1": { "name": "variable.other.property.tt" },
                "2": { "name": "keyword.operator.optional.ts" },
                "3": { "name": "keyword.operator.type.annotation.ts" }
              },
              "end": "(?=[,)])",
              "patterns": [{ "include": "#type" }]
            },
            { "match": ",", "name": "punctuation.separator.comma.ts" }
          ]
        },
        {
          "begin": "=",
          "beginCaptures": { "0": { "name": "keyword.operator.assignment.ts" } },
          "end": "(?=[,}])",
          "patterns": [{ "include": "#expression" }]
        },
        { "match": "[$_[:alpha:]][$_[:alnum:]]*", "name": "variable.other.enummember.ts" },
        { "match": ",", "name": "punctuation.separator.comma.ts" }
      ]
    },
    "tt-match-expression": {
      "name": "meta.match.tt",
      "begin": "(?<![_$[:alnum:]])(?:(?<=\\.\\.\\.)|(?<!\\.))(match)\\s*(?=\\()",
      "beginCaptures": { "1": { "name": "keyword.control.match.tt" } },
      "end": "(?<=\\})|(?=[^\\s({])",
      "patterns": [
        { "include": "#comment" },
        {
          "name": "meta.match.scrutinee.tt",
          "begin": "\\(",
          "end": "\\)",
          "beginCaptures": { "0": { "name": "meta.brace.round.ts" } },
          "endCaptures": { "0": { "name": "meta.brace.round.ts" } },
          "patterns": [{ "include": "#expression" }]
        },
        { "include": "#tt-match-body" }
      ]
    },
    "tt-match-body": {
      "name": "meta.match.body.tt",
      "begin": "\\{",
      "end": "\\}",
      "beginCaptures": { "0": { "name": "punctuation.definition.block.ts" } },
      "endCaptures": { "0": { "name": "punctuation.definition.block.ts" } },
      "patterns": [
        { "include": "#comment" },
        { "match": ",", "name": "punctuation.separator.comma.ts" },
        { "include": "#tt-match-arm" }
      ]
    },
    "tt-match-arm": {
      "name": "meta.match.arm.tt",
      "begin": "(?=[^\\s,}])",
      "end": "(?=[,}])",
      "patterns": [
        {
          "name": "meta.match.arm.body.tt",
          "begin": "=>",
          "beginCaptures": { "0": { "name": "storage.type.function.arrow.ts" } },
          "end": "(?=[,}])",
          "patterns": [{ "include": "#expression" }]
        },
        { "include": "#tt-match-arm-pattern" }
      ]
    },
    "tt-match-arm-pattern": {
      "patterns": [
        { "include": "#comment" },
        {
          "match": "(?<![_$[:alnum:]])_(?![_$[:alnum:]])",
          "name": "keyword.control.wildcard.tt"
        },
        { "match": "\\|(?!\\|)", "name": "keyword.operator.or-pattern.tt" },
        {
          "begin": "(?<![_$[:alnum:]])if(?![_$[:alnum:]])",
          "beginCaptures": { "0": { "name": "keyword.control.conditional.ts" } },
          "end": "(?==>|[,}])",
          "patterns": [{ "include": "#expression" }]
        },
        {
          "match": "(?<![_$[:alnum:]])(true|false)(?![_$[:alnum:]])",
          "name": "constant.language.boolean.ts"
        },
        { "include": "#tt-tag-pattern" },
        { "include": "#string" },
        { "include": "#numeric-literal" }
      ]
    },
    "tt-tag-pattern": {
      "patterns": [
        {
          "name": "meta.tag.pattern.tt",
          "begin": "([$_[:alpha:]][$_[:alnum:]]*)\\s*(\\()",
          "beginCaptures": {
            "1": { "name": "variable.other.enummember.ts" },
            "2": { "name": "punctuation.definition.parameters.begin.ts" }
          },
          "end": "\\)",
          "endCaptures": { "0": { "name": "punctuation.definition.parameters.end.ts" } },
          "patterns": [{ "include": "#tt-binding-list" }]
        },
        { "match": "[$_[:alpha:]][$_[:alnum:]]*", "name": "variable.other.enummember.ts" }
      ]
    },
    "tt-binding-list": {
      "patterns": [
        { "include": "#comment" },
        {
          "begin": "([$_[:alpha:]][$_[:alnum:]]*)\\s*(:)\\s*",
          "beginCaptures": {
            "1": { "name": "variable.other.property.tt" },
            "2": { "name": "punctuation.separator.key-value.ts" }
          },
          "end": "(?=[,)])",
          "patterns": [
            {
              "name": "meta.tag.pattern.tt",
              "begin": "([$_[:alpha:]][$_[:alnum:]]*)\\s*(\\()",
              "beginCaptures": {
                "1": { "name": "variable.other.enummember.ts" },
                "2": { "name": "punctuation.definition.parameters.begin.ts" }
              },
              "end": "\\)",
              "endCaptures": { "0": { "name": "punctuation.definition.parameters.end.ts" } },
              "patterns": [{ "include": "#tt-binding-list" }]
            },
            { "match": "[$_[:alpha:]][$_[:alnum:]]*", "name": "variable.other.readwrite.ts" }
          ]
        },
        { "match": "[$_[:alpha:]][$_[:alnum:]]*", "name": "variable.other.readwrite.ts" },
        { "match": ",", "name": "punctuation.separator.comma.ts" }
      ]
    },
    "tt-let-else": {
      "name": "meta.let-else.tt",
      "begin": "(?<![_$[:alnum:]])(?:(?<=\\.\\.\\.)|(?<!\\.))(const|let|var)\\s+(?=[$_[:alpha:]][$_[:alnum:]]*\\s*\\()",
      "beginCaptures": { "1": { "name": "storage.type.ts" } },
      "end": "(;)|(?=[},)])",
      "endCaptures": { "1": { "name": "punctuation.terminator.statement.ts" } },
      "patterns": [
        { "include": "#comment" },
        {
          "begin": "=(?!=|>)",
          "beginCaptures": { "0": { "name": "keyword.operator.assignment.ts" } },
          "end": "(?=(?<![_$[:alnum:]])else(?![_$[:alnum:]])|;|[},)])",
          "patterns": [{ "include": "#expression" }]
        },
        {
          "match": "(?<![_$[:alnum:]])else(?![_$[:alnum:]])",
          "name": "keyword.control.conditional.ts"
        },
        {
          "begin": "\\{",
          "end": "\\}",
          "beginCaptures": { "0": { "name": "punctuation.definition.block.ts" } },
          "endCaptures": { "0": { "name": "punctuation.definition.block.ts" } },
          "patterns": [{ "include": "#statements" }]
        },
        { "include": "#tt-tag-pattern" }
      ]
    },
    "tt-if-let": {
      "name": "meta.if-let.tt",
      "begin": "(?<![_$[:alnum:]])(if)\\s+(let)(?=\\s+[$_[:alpha:]][$_[:alnum:]]*\\s*\\()",
      "beginCaptures": {
        "1": { "name": "keyword.control.conditional.ts" },
        "2": { "name": "storage.type.ts" }
      },
      "end": "(?=\\{)|(?=[;})])",
      "patterns": [
        { "include": "#comment" },
        {
          "begin": "=(?!=|>)",
          "beginCaptures": { "0": { "name": "keyword.operator.assignment.ts" } },
          "end": "(?=\\{|[;})])",
          "patterns": [{ "include": "#expression" }]
        },
        { "include": "#tt-tag-pattern" }
      ]
    },
    "tt-result-expression": {
      "name": "meta.result.tt",
      "begin": "(?<![_$[:alnum:]])(?:(?<=\\.\\.\\.)|(?<!\\.))(result)\\s*(\\{)",
      "beginCaptures": {
        "1": { "name": "keyword.control.result.tt" },
        "2": { "name": "punctuation.definition.block.ts" }
      },
      "end": "\\}",
      "endCaptures": { "0": { "name": "punctuation.definition.block.ts" } },
      "patterns": [{ "include": "#statements" }]
    },
    "tt-pipeline-operator": {
      "match": "\\|>",
      "name": "keyword.operator.pipeline.tt"
    },
    "tt-flow-head": {
      "match": "(?<![_$[:alnum:]])(?:(?<=\\.\\.\\.)|(?<!\\.))(flow)(?=\\s*\\|>)",
      "captures": { "1": { "name": "keyword.control.flow.tt" } }
    },
    "tt-try-expression": {
      "match": "(?<![_$[:alnum:]])(?:(?<=\\.\\.\\.)|(?<!\\.))(try)(?=\\s+[^\\s({<])",
      "captures": { "1": { "name": "keyword.control.trycatch.ts" } }
    }
  }
}
