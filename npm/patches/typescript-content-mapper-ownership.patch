+import { strict as assert } from "node:assert";
+import { test } from "node:test";
+import { ContentMapperOwnership } from "../src/contentMapperOwnership";
+
+const registration = (method: string) => ({
+    id: "content-mapper-test", method,
+    registerOptions: { documentSelector: [{ pattern: "**/*.tt" }, { pattern: "**/*.vue" }] },
+});
+const overlapping = ["textDocument/hover", "textDocument/completion", "textDocument/diagnostic"];
+
+test("ownership is scoped by both method and extension", () => {
+    const owner = new ContentMapperOwnership();
+    owner.setContributions([{ extensions: [".tt"], languageFeatures: overlapping }]);
+    for (const method of overlapping) {
+        const original = registration(method);
+        assert.deepEqual(owner.filter(original)?.registerOptions.documentSelector, [{ pattern: "**/*.vue" }]);
+        assert.equal(original.registerOptions.documentSelector.length, 2);
+    }
+    for (const method of ["textDocument/codeAction", "textDocument/formatting", "textDocument/foldingRange", "textDocument/documentHighlight"]) {
+        assert.deepEqual(owner.filter(registration(method)), registration(method));
+    }
+});
+
+test("sync remains native even for invalid wire-level ownership claims", () => {
+    const owner = new ContentMapperOwnership();
+    for (const method of ["textDocument/didOpen", "textDocument/didChange", "textDocument/didClose"]) {
+        owner.setContributions([{ extensions: [".tt", ".vue"], languageFeatures: [method] }]);
+        const original = registration(method);
+        assert.equal(owner.filter(original), original);
+    }
+});
+
+test("overlapping leases retain remaining owners and release restores only their methods", () => {
+    const owner = new ContentMapperOwnership();
+    const ttHover = { extensions: [".tt"], languageFeatures: ["textDocument/hover"] };
+    const vueCompletion = { extensions: [".vue"], languageFeatures: ["textDocument/completion"] };
+    owner.setContributions([ttHover, ttHover, vueCompletion]);
+    assert.equal(owner.setContributions([vueCompletion, ttHover]), false);
+    assert.equal(owner.setContributions([vueCompletion]), true);
+    assert.deepEqual(owner.filter(registration("textDocument/hover")), registration("textDocument/hover"));
+    assert.deepEqual(owner.filter(registration("textDocument/completion"))?.registerOptions.documentSelector, [{ pattern: "**/*.tt" }]);
+    owner.setContributions([]);
+    assert.deepEqual(owner.filter(registration("textDocument/completion")), registration("textDocument/completion"));
+});
+
+test("non-mapper registrations are not affected", () => {
+    const owner = new ContentMapperOwnership();
+    owner.setContributions([{ extensions: [".tt"], languageFeatures: overlapping }]);
+    const original = { ...registration("textDocument/completion"), id: "ordinary-typescript" };
+    assert.equal(owner.filter(original), original);
+});
