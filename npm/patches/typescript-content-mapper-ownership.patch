@@ -0,0 +1,41 @@
+/** A companion claims complete language features per extension. Document
+ * synchronization is never transferred; unclaimed features remain native. */
+export interface ContentMapperFeatureClaim {
+    readonly extensions: readonly string[];
+    readonly languageFeatures?: readonly string[];
+}
+
+export class ContentMapperOwnership {
+    private claims = new Map<string, Set<string>>();
+
+    setContributions(contributions: readonly ContentMapperFeatureClaim[]): boolean {
+        const claims = new Map<string, Set<string>>();
+        for (const contribution of contributions) {
+            for (const method of contribution.languageFeatures ?? []) {
+                const patterns = claims.get(method) ?? new Set<string>();
+                for (const extension of contribution.extensions) patterns.add(`**/*${extension}`);
+                claims.set(method, patterns);
+            }
+        }
+        if (claims.size === this.claims.size && [...claims].every(([method, patterns]) => {
+            const previous = this.claims.get(method);
+            return previous?.size === patterns.size && [...patterns].every(pattern => previous.has(pattern));
+        })) return false;
+        this.claims = claims;
+        return true;
+    }
+
+    ownsPattern(method: string, pattern: string): boolean {
+        return this.claims.get(method)?.has(pattern) ?? false;
+    }
+
+    filter<T extends { id: string; method: string; registerOptions?: any; }>(registration: T): T | undefined {
+        if (!registration.id.startsWith("content-mapper-") ||
+            ["textDocument/didOpen", "textDocument/didChange", "textDocument/didClose"].includes(registration.method)) return registration;
+        const options = registration.registerOptions;
+        if (!Array.isArray(options?.documentSelector)) return registration;
+        const documentSelector = options.documentSelector.filter((selector: { pattern?: string; }) =>
+            !selector.pattern || !this.ownsPattern(registration.method, selector.pattern));
+        return documentSelector.length ? { ...registration, registerOptions: { ...options, documentSelector } } : undefined;
+    }
+}
