{
  "name": "@openload28/tt-lang",
  "version": "1.0.0-beta",
  "description": "tt — a tiny TypeScript preprocessor adding Rust-style variants, match expressions, try, let-else, if let and the pipeline operator. Installs the ttc compiler.",
  "license": "MIT",
  "bin": {
    "ttc": "bin/ttc.js"
  },
  "main": "index.js",
  "typescript": {
    "contentMapper": {
      "exec": [
        "node",
        "bin/ttc.js",
        "--content-mapper"
      ]
    }
  },
  "files": [
    "bin/ttc.js",
    "index.js",
    "platforms.json",
    "dev.js",
    "tt-dev.local.json",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/load28/tt",
    "directory": "npm/tt-lang"
  },
  "homepage": "https://github.com/load28/tt#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "typescript",
    "compiler",
    "preprocessor",
    "tagged-union",
    "pattern-matching",
    "match",
    "tt"
  ],
  "engines": {
    "node": ">=18"
  },
  "optionalDependencies": {
    "@openload28/tt-lang-linux-x64": "1.0.0-beta",
    "@openload28/tt-lang-linux-arm64": "1.0.0-beta",
    "@openload28/tt-lang-darwin-x64": "1.0.0-beta",
    "@openload28/tt-lang-darwin-arm64": "1.0.0-beta",
    "@openload28/tt-lang-win32-x64-msvc": "1.0.0-beta"
  }
}
