#!/usr/bin/env node
import { spawnSync } from "node:child_process";
import { existsSync, readdirSync, statSync } from "node:fs";
import { dirname, join, relative, resolve, sep } from "node:path";
import { fileURLToPath } from "node:url";

const ROOT = resolve(dirname(fileURLToPath(import.meta.url)), "..");
const LOCAL = join(ROOT, "tests/baselines/local");
const REFERENCE = join(ROOT, "tests/baselines/reference");

function walk(dir, out) {
  if (!existsSync(dir)) return out;
  for (const name of readdirSync(dir)) {
    const path = join(dir, name);
    if (statSync(path).isDirectory()) walk(path, out);
    else out.push(path);
  }
  return out;
}

function referenceOf(local) {
  const inside = relative(LOCAL, local).split(sep).join("/");
  return inside.startsWith("tests/") ? join(ROOT, inside) : join(REFERENCE, inside);
}

const tool = process.env.DIFF;
const files = walk(LOCAL, []).sort();
if (files.length === 0) {
  console.log("baseline-diff: tests/baselines/local is empty; every baseline the last run compared matched");
  process.exit(0);
}
for (const file of files) {
  const deleting = file.endsWith(".delete");
  const target = referenceOf(deleting ? file.slice(0, -".delete".length) : file);
  const reference = existsSync(target) ? relative(ROOT, target) : "/dev/null";
  const local = deleting ? "/dev/null" : relative(ROOT, file);
  if (tool) {
    spawnSync(tool, [reference, local], { stdio: "inherit" });
    continue;
  }
  spawnSync("git", ["--no-pager", "diff", "--no-index", "--", reference, local], {
    cwd: ROOT,
    stdio: "inherit",
  });
}
console.log(`\nbaseline-diff: ${files.length} baseline(s) differ; accept them with scripts/baseline-accept`);
