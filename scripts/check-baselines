#!/usr/bin/env node
import { spawnSync } from "node:child_process";
import { existsSync, mkdtempSync, readdirSync, readFileSync, rmSync, statSync, unlinkSync, writeFileSync } from "node:fs";
import { tmpdir } from "node:os";
import { dirname, join, relative, resolve, sep } from "node:path";
import { fileURLToPath } from "node:url";

const ROOT = resolve(dirname(fileURLToPath(import.meta.url)), "..");

const OWNERS = [
  { root: "tests/baselines/reference", binary: "case_baselines", reference: (path) => !path.startsWith("tests/baselines/reference/editor/") },
  { root: "tests/baselines/reference/editor", binary: "editor_cases", reference: () => true },
  { root: "tests/fixtures/emit", binary: "snapshot", reference: isExpected },
  { root: "tests/fixtures/diagnostic", binary: "snapshot", reference: isExpected },
  { root: "tests/fixtures/practical-diagnostics", binary: "practical_diagnostics", reference: isExpected },
];

function isExpected(path) {
  return path.split("/").pop().startsWith("expected.");
}

const BINARIES = [...new Set(OWNERS.map((owner) => owner.binary))];

function walk(dir, out) {
  if (!existsSync(dir)) return out;
  for (const name of readdirSync(dir)) {
    const path = join(dir, name);
    if (statSync(path).isDirectory()) walk(path, out);
    else out.push(relative(ROOT, path).split(sep).join("/"));
  }
  return out;
}

function references() {
  const files = [];
  for (const owner of OWNERS) {
    for (const path of walk(join(ROOT, owner.root), [])) {
      if (owner.reference(path)) files.push({ path, binary: owner.binary });
    }
  }
  return files;
}

function readTracking(dir) {
  const runs = new Map();
  const present = new Set();
  const absent = new Set();
  if (!existsSync(dir)) return { runs, present, absent };
  for (const name of readdirSync(dir)) {
    const lines = readFileSync(join(dir, name), "utf8").split("\n");
    for (const line of lines) {
      const header = /^binary (\S+) filtered (true|false)$/.exec(line);
      if (header) {
        const [, binary, filtered] = header;
        runs.set(binary, (runs.get(binary) ?? false) || filtered === "true");
        continue;
      }
      const entry = /^(present|absent) (.+)$/.exec(line);
      if (entry) (entry[1] === "present" ? present : absent).add(entry[2]);
    }
  }
  return { runs, present, absent };
}

function check(dir, { accept }) {
  const { runs, present, absent } = readTracking(dir);
  const problems = [];
  for (const binary of BINARIES) {
    if (!runs.has(binary)) {
      problems.push(`${binary} recorded no baseline: it did not run, or it skipped its baselines (set TTC_REQUIRE_TSGO=1)`);
    } else if (runs.get(binary)) {
      problems.push(`${binary} ran with a test filter, so its unused baselines cannot be told apart from unrun ones`);
    }
  }
  if (problems.length > 0) {
    report("baseline tracking is incomplete:", problems, "Run the whole suite: node scripts/check-baselines --run");
    return false;
  }

  const unused = references()
    .map((file) => file.path)
    .filter((path) => !present.has(path) && !absent.has(path));
  const unowned = [...present].filter((path) => !OWNERS.some((owner) => path.startsWith(`${owner.root}/`) && owner.reference(path)));
  const missing = [...present].filter((path) => !existsSync(join(ROOT, path)));

  if (accept) {
    for (const path of unused) unlinkSync(join(ROOT, path));
    if (unused.length > 0) console.log(`deleted ${unused.length} unused baseline(s):\n  ${unused.join("\n  ")}`);
  }

  let ok = true;
  if (!accept && unused.length > 0) {
    report(
      `${unused.length} unused baseline(s): no test compared them`,
      unused,
      "Delete them, or run `node scripts/check-baselines --run --accept`, and review the diff.",
    );
    ok = false;
  }
  if (missing.length > 0) {
    report(
      `${missing.length} missing baseline(s): a test compared against a file that does not exist`,
      missing,
      "Run `UPDATE_EXPECT=1 cargo test --test <binary>` and review the diff.",
    );
    ok = false;
  }
  if (unowned.length > 0) {
    report(
      `${unowned.length} baseline(s) outside every root in scripts/check-baselines`,
      unowned,
      "Add the root to OWNERS, so an unused file under it is found.",
    );
    ok = false;
  }
  if (ok) console.log(`baselines: ${present.size + absent.size} compared, none unused`);
  return ok;
}

function report(title, items, hint) {
  console.error(`error: ${title}`);
  for (const item of items) console.error(`  ${item}`);
  console.error(hint);
}

function run({ accept }) {
  const dir = mkdtempSync(join(tmpdir(), "tt-baseline-tracking-"));
  try {
    const env = { ...process.env, TT_BASELINE_TRACKING_DIR: dir, TTC_REQUIRE_TSGO: "1" };
    delete env.TT_CASES;
    if (accept) env.UPDATE_EXPECT = "1";
    else delete env.UPDATE_EXPECT;
    const args = ["test", ...BINARIES.flatMap((binary) => ["--test", binary])];
    console.log(`$ ${accept ? "UPDATE_EXPECT=1 " : ""}cargo ${args.join(" ")}`);
    const tests = spawnSync("cargo", args, { cwd: ROOT, env, stdio: "inherit" });
    const checked = check(dir, { accept });
    return tests.status === 0 && checked;
  } finally {
    rmSync(dir, { recursive: true, force: true });
  }
}

function git(args, options = {}) {
  const result = spawnSync("git", args, { cwd: ROOT, encoding: "utf8", ...options });
  if (result.status !== 0 && !options.allowFailure) {
    throw new Error(`git ${args.join(" ")} failed: ${result.stderr}`);
  }
  return result;
}

function ci() {
  const regenerated = run({ accept: true });
  const roots = [...new Set(OWNERS.map((owner) => owner.root))];
  git(["add", "--all", "--", ...roots]);
  const changed = git(["diff", "--staged", "--quiet", "--", ...roots], { allowFailure: true }).status !== 0;
  if (changed) {
    const groups = [
      ["ACR", "Missing baselines"],
      ["MTUXB", "Modified baselines"],
      ["D", "Unused baselines"],
    ];
    for (const [filter, title] of groups) {
      const names = git(["diff", "--staged", "--name-only", `--diff-filter=${filter}`, "--", ...roots]).stdout.trim();
      if (names) console.error(`${title}:\n${names}`);
    }
    writeFileSync(join(ROOT, "fix_baselines.patch"), git(["diff", "--staged", "--binary", "--", ...roots]).stdout);
    console.error(
      "\nThe committed baselines differ from what the tests produce. Apply fix_baselines.patch\n" +
        "(or run `node scripts/check-baselines --run --accept`), review the diff, and commit it with the change.",
    );
  }
  return regenerated && !changed;
}

const argv = process.argv.slice(2);
let ok;
if (argv[0] === "--tracking" && argv[1]) {
  ok = check(resolve(argv[1]), { accept: false });
} else if (argv[0] === "--run") {
  ok = run({ accept: argv.includes("--accept") });
} else if (argv[0] === "--ci") {
  ok = ci();
} else {
  console.error(
    [
      "usage:",
      "  node scripts/check-baselines --tracking <dir>   check what cargo test recorded with TT_BASELINE_TRACKING_DIR=<dir>",
      "  node scripts/check-baselines --run [--accept]   run the baseline suites with tracking; --accept regenerates and deletes unused baselines",
      "  node scripts/check-baselines --ci               --run --accept, then fail on any difference and write fix_baselines.patch",
    ].join("\n"),
  );
  process.exit(2);
}
process.exit(ok ? 0 : 1);
