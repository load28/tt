#!/usr/bin/env bash
# Read-only diagnosis for the local TT development environment.

set -u

TT_ROOT="$(cd "$(dirname "$0")/.." && pwd -P)"
PKG_MARKER="$TT_ROOT/npm/tt-lang/tt-dev.local.json"
VSIX="$TT_ROOT/.tt-dev/tt-language.vsix"
FAILURES=0
WARNINGS=0

pass() {
  printf 'ok: %s\n' "$*"
}

fail() {
  printf 'error: %s\n' "$*" >&2
  FAILURES=$((FAILURES + 1))
}

warn() {
  printf 'warning: %s\n' "$*" >&2
  WARNINGS=$((WARNINGS + 1))
}

have() {
  command -v "$1" > /dev/null 2>&1
}

check_command() {
  if have "$1"; then
    pass "$1: $(command -v "$1")"
  else
    fail "$1 is not on PATH"
  fi
}

# The version rust-toolchain.toml pins, so the report can say whether this
# checkout is actually building with it.
pinned_rust() {
  sed -n 's/^channel[[:space:]]*=[[:space:]]*"\(.*\)"/\1/p' \
    "$TT_ROOT/rust-toolchain.toml" 2> /dev/null | head -n 1
}

printf 'TT development environment\n'
printf '  root: %s\n\n' "$TT_ROOT"

printf 'Required tools\n'
check_command cargo
check_command rustc
check_command node
check_command npm

if have rustc; then
  RUST_VERSION="$(rustc --version 2> /dev/null | awk '{print $2}')"
  PINNED_RUST="$(pinned_rust)"
  # Every gate — fmt, clippy, test — answers differently on a different
  # toolchain, so "it passed locally" only means something when this
  # checkout builds with the version CI builds with (TASK-226).
  if [ -z "$PINNED_RUST" ]; then
    fail "rust-toolchain.toml does not name a channel"
  elif [ "$RUST_VERSION" = "$PINNED_RUST" ]; then
    pass "Rust $RUST_VERSION matches rust-toolchain.toml"
  else
    fail "Rust $RUST_VERSION is active but rust-toolchain.toml pins $PINNED_RUST (rustup should select it; is rustc from rustup?)"
  fi
fi

printf '\nTypeScript\n'
# A project's TypeScript is the one in its own node_modules and there is no
# way to name another (src/typescript/toolchain.rs). For this repository
# that is package.json's pinned version, installed by `npm ci` — the typed
# suites and the editor both read it.
TS_PKG="$TT_ROOT/node_modules/typescript/package.json"
if [ ! -f "$TS_PKG" ]; then
  fail "TypeScript is not installed: run npm ci (or ./scripts/setup)"
elif ! have node; then
  fail "cannot read the installed TypeScript version without Node.js"
else
  TS_VERSION="$(node -p "require('$TS_PKG').version" 2> /dev/null || true)"
  PINNED_TS="$(node -p "require('$TT_ROOT/package.json').devDependencies.typescript" 2> /dev/null || true)"
  if [ -z "$TS_VERSION" ]; then
    fail "the installed TypeScript is unreadable: $TS_PKG"
  elif [ "$TS_VERSION" = "$PINNED_TS" ]; then
    pass "TypeScript $TS_VERSION matches package.json"
  else
    fail "TypeScript $TS_VERSION is installed but package.json pins ${PINNED_TS:-<none>} (run npm ci)"
  fi
  # Declaration emit (`ttc --types`, editor sidecars) arrived in 7.1.
  if grep -q "getDeclarationEmit" "$TT_ROOT/node_modules/typescript/dist/api/sync/api.js" 2> /dev/null; then
    pass "declaration emit is available"
  else
    fail "the installed TypeScript cannot emit declarations — pin a 7.1 in package.json"
  fi
fi

printf '\nTT artifacts\n'
case "$(uname -s)" in
  MINGW* | MSYS* | CYGWIN*) TTC_EXE="ttc.exe" ;;
  *) TTC_EXE="ttc" ;;
esac

TTC_BIN="$TT_ROOT/target/release/$TTC_EXE"
if [ -x "$TTC_BIN" ] && "$TTC_BIN" -v > /dev/null 2>&1; then
  pass "release compiler: target/release/$TTC_EXE"
else
  fail "release compiler is missing or not runnable: target/release/$TTC_EXE"
fi

if [ ! -f "$PKG_MARKER" ]; then
  fail "local npm launcher marker is missing: $PKG_MARKER"
elif ! have node; then
  fail "cannot verify the local npm launcher marker without Node.js"
else
  MARKER_ROOT="$(node -e '
    try {
      const value = JSON.parse(require("fs").readFileSync(process.argv[1], "utf8")).root;
      if (typeof value === "string") process.stdout.write(value);
    } catch {}
  ' "$PKG_MARKER")"
  if [ "$MARKER_ROOT" = "$TT_ROOT" ]; then
    pass "local npm launcher is linked to this checkout"
  else
    fail "local npm launcher points elsewhere: ${MARKER_ROOT:-<unreadable>}"
  fi
fi
[ -f "$VSIX" ] \
  && pass "VS Code package: .tt-dev/tt-language.vsix" \
  || warn "VS Code package is missing: $VSIX"

printf '\nSummary\n'
if [ "$FAILURES" -eq 0 ]; then
  printf 'ready: local TT development environment is configured'
  [ "$WARNINGS" -gt 0 ] && printf ' (%s warning(s))' "$WARNINGS"
  printf '\n'
  exit 0
fi

printf 'not ready: %s error(s), %s warning(s)\n' "$FAILURES" "$WARNINGS" >&2
printf '\nNext action\n' >&2
printf '  After resolving prerequisite errors, build this checkout with:\n' >&2
printf '    ./scripts/setup\n' >&2
exit 1
