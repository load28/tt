#!/usr/bin/env bash
# ----------------------------------------------------------------------------
# scripts/setup — build the local TT development environment.
#
#   ./scripts/setup
#
# What it does, in order (any failure stops the run):
#
#   1. install this repository's npm dependencies (npm ci) — TypeScript 7 is
#      one of them, pinned in package.json, and it is where the typed suites
#      and the editor get their compiler from
#   2. clean all TT Cargo artifacts (debug + release), rebuild the current
#      checkout in release mode, and verify ttc
#   3. stamp npm/tt-lang for local `file:` installs (tt-dev.local.json)
#   4. build the VSCode extension and reinstall it (uninstall first when an
#      old install exists; skipped when the `code` CLI is not on PATH)
#
# There is no TypeScript toolchain to choose: a project's TypeScript is the
# one in its own node_modules and there is no way to name another
# (src/typescript/toolchain.rs). That is what makes the editor and the
# command line provably drive the same compiler (TASK-256).
#
# What it never does: touch git state (pull/checkout/reset — updating the
# repository is the user's move), or write to your shell profile.
#
# The `file:`-install layer is temporary (docs/tasks/TASK-090): once TT ships
# a verified TypeScript inside its own package, delete this script, .tt-dev/
# and npm/tt-lang/dev.js together.
# ----------------------------------------------------------------------------
set -euo pipefail

TT_ROOT="$(cd "$(dirname "$0")/.." && pwd -P)"
CONFIG_DIR="$TT_ROOT/.tt-dev"
PKG_DIR="$TT_ROOT/npm/tt-lang"

fail() {
  echo "error: $*" >&2
  exit 1
}

usage() {
  cat <<EOF
usage: ./scripts/setup

Builds this checkout: npm dependencies (TypeScript included), a release ttc,
the local package stamp, and the VSCode extension.
EOF
}

# ---------------------------------------------------------------- arguments --
while [ $# -gt 0 ]; do
  case "$1" in
    -h | --help)
      usage
      exit 0
      ;;
    *) fail "unknown argument: $1
$(usage)" ;;
  esac
done

# -------------------------------------------------- npm dependencies (TS 7) --
command -v cargo > /dev/null 2>&1 || fail "Rust (cargo) is required to build ttc."
command -v npm > /dev/null 2>&1 || fail "npm is required to install TypeScript."

# `npm ci` deletes node_modules, so run it only when the tree is missing or
# older than the lockfile — otherwise every setup pays the full install.
if [ ! -d "$TT_ROOT/node_modules" ] \
  || [ "$TT_ROOT/package-lock.json" -nt "$TT_ROOT/node_modules/.package-lock.json" ]; then
  echo "==> installing npm dependencies (npm ci)"
  (cd "$TT_ROOT" && npm ci) || fail "failed to install npm dependencies."
fi
TS_VERSION="$(node -p "require('$TT_ROOT/node_modules/typescript/package.json').version" 2>/dev/null || true)"
[ -n "$TS_VERSION" ] || fail "TypeScript is not installed after npm ci.
  expected: $TT_ROOT/node_modules/typescript"
echo "==> TypeScript: $TS_VERSION (from package.json)"

# ------------------------------------------------------------------ build TT --
echo "==> cleaning ttc build artifacts (cargo clean: debug + release)"
(cd "$TT_ROOT" && cargo clean) || fail "failed to clean ttc build artifacts."
echo "==> building ttc (cargo build --release)"
(cd "$TT_ROOT" && cargo build --release) || fail "failed to build ttc."
case "$(uname -s)" in
  MINGW* | MSYS* | CYGWIN*) TTC_EXE="ttc.exe" ;;
  *) TTC_EXE="ttc" ;;
esac
TTC_BIN="$TT_ROOT/target/release/$TTC_EXE"
[ -f "$TTC_BIN" ] || fail "failed to build ttc.
  missing: $TTC_BIN"

# -------------------------------------------------- stamp the local package --
# tt-dev.local.json marks npm/tt-lang as a local development install: the
# launcher (dev.js) then runs this repository's release ttc. TypeScript is
# not part of it — a consuming project resolves its own. The file is
# machine-local and gitignored.
node -e '
  require("fs").writeFileSync(
    process.argv[1],
    JSON.stringify({ root: process.argv[2] }, null, 2) + "\n",
  );
' "$PKG_DIR/tt-dev.local.json" "$TT_ROOT"

# ------------------------------------------------------------------- VSCode --
EXT_DIR="$TT_ROOT/editors/vscode"
EXT_ID="tt-lang.tt-language"
VSIX="$CONFIG_DIR/tt-language.vsix"
mkdir -p "$CONFIG_DIR"

echo "==> building the VSCode extension"
if [ ! -d "$EXT_DIR/node_modules" ] \
  || [ ! -d "$EXT_DIR/client/node_modules" ] \
  || [ ! -d "$EXT_DIR/server/node_modules" ] \
  || [ "$EXT_DIR/package-lock.json" -nt "$EXT_DIR/node_modules/.package-lock.json" ]; then
  (cd "$EXT_DIR" && npm ci) || fail "failed to build VSCode extension."
fi
(cd "$EXT_DIR" && npx tsc -b) || fail "failed to build VSCode extension."
(cd "$EXT_DIR" && npx --yes @vscode/vsce package --no-dependencies -o "$VSIX") \
  || fail "failed to build VSCode extension."

# Update = uninstall + install, never an overwrite; first install just skips
# the uninstall.
if command -v code > /dev/null 2>&1; then
  if code --list-extensions 2> /dev/null | grep -qix "$EXT_ID"; then
    echo "==> uninstalling the existing TT extension"
    code --uninstall-extension "$EXT_ID" > /dev/null \
      || fail "failed to uninstall the existing TT extension."
    VSCODE_STATUS="TT extension reinstalled"
  else
    VSCODE_STATUS="TT extension installed"
  fi
  echo "==> installing the TT extension"
  code --install-extension "$VSIX" > /dev/null \
    || fail "failed to install the TT extension."
else
  VSCODE_STATUS="build ready, install skipped — no 'code' CLI on PATH
  (install manually: code --install-extension $VSIX)"
fi

# ------------------------------------------------------------------ summary --
echo
echo "TT development environment ready"
echo "TT"
echo "  root: $TT_ROOT"
echo "  ttc: target/release/$TTC_EXE"
echo "TypeScript"
echo "  $TS_VERSION (node_modules/typescript, pinned in package.json)"
echo "  a consuming project installs its own: pnpm add -D typescript@7"
echo "VSCode"
echo "  $VSCODE_STATUS"
echo "Local package"
echo "  $PKG_DIR"
echo "Install into a test project with:"
echo "  pnpm add -D file:$PKG_DIR"
