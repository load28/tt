=== aNonExhaustiveMatchCoversItsHead.tt ===
variant S { A(x: number), B }
>S : type S = {
>       kind: "A";
>       x: number;
>   } | {
>       kind: "B";
>   }
>A : (property) A: (x: number) => S
>x : (property) x: number
>B : (property) B: {
>       readonly kind: "B";
>   }
const v = match (s) { A(x) => x };
>v : const v: any
>x : const x: any
>x : const x: any

