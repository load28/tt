=== localVariantShadowsBuiltin.tt ===
variant Option { Some(), Stale }
>Option : type Option = {
>       kind: "Some";
>   } | {
>       kind: "Stale";
>   }
>Some : (property) Some: () => Option
>Stale : (property) Stale: {
>       readonly kind: "Stale";
>   }
const f = (o: Option) => match (o) { Some => 1 };
>f : const f: (o: Option) => number
>o : (parameter) o: Option
>Option : type Option = /*unresolved*/ any
>o : (parameter) o: Option

