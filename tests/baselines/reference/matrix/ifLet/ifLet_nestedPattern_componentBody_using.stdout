componentBody({"kind":"Done","value":{"kind":"Some","value":5}}) => "<p>5</p>" | open res; operand {"kind":"Done","value":{"kind":"Some","value":5}}; some 5; dispose res
componentBody({"kind":"Done","value":{"kind":"None"}}) => "<p>\"other\"</p>" | open res; operand {"kind":"Done","value":{"kind":"None"}}; dispose res
componentBody({"kind":"Failed","error":"gone"}) => "<p>\"other\"</p>" | open res; operand {"kind":"Failed","error":"gone"}; dispose res
