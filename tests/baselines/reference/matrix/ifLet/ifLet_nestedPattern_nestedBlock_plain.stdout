nestedBlock({"kind":"Done","value":{"kind":"Some","value":5}}) => 5 | operand {"kind":"Done","value":{"kind":"Some","value":5}}; some 5
nestedBlock({"kind":"Done","value":{"kind":"None"}}) => "other" | operand {"kind":"Done","value":{"kind":"None"}}
nestedBlock({"kind":"Failed","error":"gone"}) => "other" | operand {"kind":"Failed","error":"gone"}
