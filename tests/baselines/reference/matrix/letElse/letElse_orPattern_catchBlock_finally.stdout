catchBlock({"kind":"Num","value":1}) => 1 | throw "boom"; operand {"kind":"Num","value":1}; finally 0
catchBlock({"kind":"Neg","value":-2}) => -2 | throw "boom"; operand {"kind":"Neg","value":-2}; finally 0
catchBlock({"kind":"Word","text":"w"}) => "diverged" | throw "boom"; operand {"kind":"Word","text":"w"}; finally 0
