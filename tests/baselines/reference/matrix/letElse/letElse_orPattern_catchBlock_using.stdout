catchBlock({"kind":"Num","value":1}) => 1 | open res; throw "boom"; operand {"kind":"Num","value":1}; dispose res
catchBlock({"kind":"Neg","value":-2}) => -2 | open res; throw "boom"; operand {"kind":"Neg","value":-2}; dispose res
catchBlock({"kind":"Word","text":"w"}) => "diverged" | open res; throw "boom"; operand {"kind":"Word","text":"w"}; dispose res
