forOfBody({"kind":"Num","value":1}) => [1,1] | round 0; yield {"kind":"Num","value":1}; round 1; yield {"kind":"Num","value":1}
forOfBody({"kind":"Neg","value":-2}) => [-2,-2] | round 0; yield {"kind":"Neg","value":-2}; round 1; yield {"kind":"Neg","value":-2}
forOfBody({"kind":"Word","text":"w"}) => [] | round 0; yield {"kind":"Word","text":"w"}; round 1; yield {"kind":"Word","text":"w"}
