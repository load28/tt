conditionalTest({"kind":"Circle","r":2}) => "falsy" | yield {"kind":"Circle","r":2}; other 0; else "falsy"
conditionalTest({"kind":"Rect","w":3,"h":4}) => "truthy" | yield {"kind":"Rect","w":3,"h":4}; area 12; large 12; then "truthy"
conditionalTest({"kind":"Point"}) => "falsy" | yield {"kind":"Point"}; other 0; else "falsy"
