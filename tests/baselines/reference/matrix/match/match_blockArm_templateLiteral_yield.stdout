templateLiteral({"kind":"Circle","r":2}) => "<L|0|R>" | left "L"; yield {"kind":"Circle","r":2}; other 0; right "R"
templateLiteral({"kind":"Rect","w":3,"h":4}) => "<L|12|R>" | left "L"; yield {"kind":"Rect","w":3,"h":4}; area 12; large 12; right "R"
templateLiteral({"kind":"Point"}) => "<L|0|R>" | left "L"; yield {"kind":"Point"}; other 0; right "R"
