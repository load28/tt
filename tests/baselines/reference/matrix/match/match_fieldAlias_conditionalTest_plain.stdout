conditionalTest({"kind":"Circle","r":2}) => "truthy" | operand {"kind":"Circle","r":2}; circle 2; then "truthy"
conditionalTest({"kind":"Rect","w":3,"h":4}) => "truthy" | operand {"kind":"Rect","w":3,"h":4}; rect [3,4]; then "truthy"
conditionalTest({"kind":"Point"}) => "falsy" | operand {"kind":"Point"}; point null; else "falsy"
