matchArm({"kind":"Circle","r":2}) => 2 | open res; flip true; operand {"kind":"Circle","r":2}; circle 2; dispose res
matchArm({"kind":"Rect","w":3,"h":4}) => 0 | open res; flip false; other arm 0; dispose res
matchArm({"kind":"Point"}) => null | open res; flip true; operand {"kind":"Point"}; point null; dispose res
