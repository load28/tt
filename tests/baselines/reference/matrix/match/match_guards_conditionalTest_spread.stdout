conditionalTest({"kind":"Circle","r":1}) => "truthy" | guard big false; small 1; then "truthy"
conditionalTest({"kind":"Circle","r":5}) => "truthy" | guard big true; big 5; then "truthy"
conditionalTest({"kind":"Rect","w":4,"h":2}) => "truthy" | guard wide true; wide 4; then "truthy"
conditionalTest({"kind":"Rect","w":1,"h":3}) => "truthy" | guard wide false; tall 3; then "truthy"
conditionalTest({"kind":"Point"}) => "falsy" | point 0; else "falsy"
