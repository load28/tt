nullish({"kind":"Circle","r":1}) => 1 | flip true; await; guard big false; small 1
nullish({"kind":"Circle","r":5}) => "set" | flip false; left "set"
nullish({"kind":"Rect","w":4,"h":2}) => 4 | flip true; await; guard wide true; wide 4
nullish({"kind":"Rect","w":1,"h":3}) => "set" | flip false; left "set"
nullish({"kind":"Point"}) => 0 | flip true; await; point 0
