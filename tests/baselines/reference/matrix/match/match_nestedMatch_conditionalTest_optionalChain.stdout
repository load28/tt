conditionalTest({"kind":"Circle","r":2}) => "truthy" | inner circle 2; again {"kind":"Point"}; point "some"; then "truthy"
conditionalTest({"kind":"Rect","w":3,"h":4}) => "truthy" | inner rect 3; again {"kind":"Point"}; point "some"; then "truthy"
conditionalTest({"kind":"Point"}) => "truthy" | inner point 0; zero "none"; then "truthy"
