forOfHead({"kind":"Circle","r":2}) => ["some"] | yield {"kind":"Circle","r":2}; inner circle 2; again {"kind":"Point"}; point "some"
forOfHead({"kind":"Rect","w":3,"h":4}) => ["some"] | yield {"kind":"Rect","w":3,"h":4}; inner rect 3; again {"kind":"Point"}; point "some"
forOfHead({"kind":"Point"}) => ["none"] | yield {"kind":"Point"}; inner point 0; zero "none"
