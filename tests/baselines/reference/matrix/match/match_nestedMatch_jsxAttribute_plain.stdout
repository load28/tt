jsxAttribute({"kind":"Circle","r":2}) => "<div data-value='some'></div>" | operand {"kind":"Circle","r":2}; inner circle 2; again {"kind":"Point"}; point "some"
jsxAttribute({"kind":"Rect","w":3,"h":4}) => "<div data-value='some'></div>" | operand {"kind":"Rect","w":3,"h":4}; inner rect 3; again {"kind":"Point"}; point "some"
jsxAttribute({"kind":"Point"}) => "<div data-value='none'></div>" | operand {"kind":"Point"}; inner point 0; zero "none"
