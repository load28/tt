jsxConditional({"kind":"Circle","r":2}) => "<p>some</p>" | flip true; yield {"kind":"Circle","r":2}; inner circle 2; again {"kind":"Point"}; point "some"
jsxConditional({"kind":"Rect","w":3,"h":4}) => "<p></p>" | flip false
jsxConditional({"kind":"Point"}) => "<p>none</p>" | flip true; yield {"kind":"Point"}; inner point 0; zero "none"
