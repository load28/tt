jsxFragment({"kind":"Circle","r":2}) => "<>[some]</>" | before "["; inner circle 2; again {"kind":"Point"}; point "some"; after "]"
jsxFragment({"kind":"Rect","w":3,"h":4}) => "<>[some]</>" | before "["; inner rect 3; again {"kind":"Point"}; point "some"; after "]"
jsxFragment({"kind":"Point"}) => "<>[none]</>" | before "["; inner point 0; zero "none"; after "]"
