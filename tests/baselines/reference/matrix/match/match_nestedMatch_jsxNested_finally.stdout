jsxNested({"kind":"Circle","r":2}) => "<ul><li>1</li><li>some</li></ul>" | first 1; operand {"kind":"Circle","r":2}; inner circle 2; again {"kind":"Point"}; point "some"; finally 0
jsxNested({"kind":"Rect","w":3,"h":4}) => "<ul><li>1</li><li>some</li></ul>" | first 1; operand {"kind":"Rect","w":3,"h":4}; inner rect 3; again {"kind":"Point"}; point "some"; finally 0
jsxNested({"kind":"Point"}) => "<ul><li>1</li><li>none</li></ul>" | first 1; operand {"kind":"Point"}; inner point 0; zero "none"; finally 0
