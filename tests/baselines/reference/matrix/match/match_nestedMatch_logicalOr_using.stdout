logicalOr({"kind":"Circle","r":2}) => true | open res; flip true; dispose res
logicalOr({"kind":"Rect","w":3,"h":4}) => "some" | open res; flip false; operand {"kind":"Rect","w":3,"h":4}; inner rect 3; again {"kind":"Point"}; point "some"; dispose res
logicalOr({"kind":"Point"}) => true | open res; flip true; dispose res
