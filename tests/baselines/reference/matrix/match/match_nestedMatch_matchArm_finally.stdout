matchArm({"kind":"Circle","r":2}) => "some" | flip true; operand {"kind":"Circle","r":2}; inner circle 2; again {"kind":"Point"}; point "some"; finally 0
matchArm({"kind":"Rect","w":3,"h":4}) => 0 | flip false; other arm 0; finally 0
matchArm({"kind":"Point"}) => "none" | flip true; operand {"kind":"Point"}; inner point 0; zero "none"; finally 0
