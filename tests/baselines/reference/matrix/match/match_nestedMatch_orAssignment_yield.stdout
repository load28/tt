orAssignment({"kind":"Circle","r":2}) => "some" | flip true; target {"value":0}; yield {"kind":"Circle","r":2}; inner circle 2; again {"kind":"Point"}; point "some"
orAssignment({"kind":"Rect","w":3,"h":4}) => "kept" | flip false; target {"value":"kept"}
orAssignment({"kind":"Point"}) => "none" | flip true; target {"value":0}; yield {"kind":"Point"}; inner point 0; zero "none"
