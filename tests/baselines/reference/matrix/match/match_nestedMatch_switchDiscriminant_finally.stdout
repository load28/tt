switchDiscriminant({"kind":"Circle","r":2}) => "default" | operand {"kind":"Circle","r":2}; inner circle 2; again {"kind":"Point"}; point "some"; case 0; finally 0
switchDiscriminant({"kind":"Rect","w":3,"h":4}) => "default" | operand {"kind":"Rect","w":3,"h":4}; inner rect 3; again {"kind":"Point"}; point "some"; case 0; finally 0
switchDiscriminant({"kind":"Point"}) => "default" | operand {"kind":"Point"}; inner point 0; zero "none"; case 0; finally 0
