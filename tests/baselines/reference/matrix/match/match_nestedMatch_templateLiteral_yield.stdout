templateLiteral({"kind":"Circle","r":2}) => "<L|some|R>" | left "L"; yield {"kind":"Circle","r":2}; inner circle 2; again {"kind":"Point"}; point "some"; right "R"
templateLiteral({"kind":"Rect","w":3,"h":4}) => "<L|some|R>" | left "L"; yield {"kind":"Rect","w":3,"h":4}; inner rect 3; again {"kind":"Point"}; point "some"; right "R"
templateLiteral({"kind":"Point"}) => "<L|none|R>" | left "L"; yield {"kind":"Point"}; inner point 0; zero "none"; right "R"
