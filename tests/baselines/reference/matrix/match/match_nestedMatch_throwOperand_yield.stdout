throwOperand({"kind":"Circle","r":2}) => threw "some" | yield {"kind":"Circle","r":2}; inner circle 2; again {"kind":"Point"}; point "some"
throwOperand({"kind":"Rect","w":3,"h":4}) => threw "some" | yield {"kind":"Rect","w":3,"h":4}; inner rect 3; again {"kind":"Point"}; point "some"
throwOperand({"kind":"Point"}) => threw "none" | yield {"kind":"Point"}; inner point 0; zero "none"
