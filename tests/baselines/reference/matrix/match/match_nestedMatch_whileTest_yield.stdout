whileTest({"kind":"Circle","r":2}) => 1 | yield {"kind":"Circle","r":2}; inner circle 2; again {"kind":"Point"}; point "some"
whileTest({"kind":"Rect","w":3,"h":4}) => 1 | yield {"kind":"Rect","w":3,"h":4}; inner rect 3; again {"kind":"Point"}; point "some"
whileTest({"kind":"Point"}) => 1 | yield {"kind":"Point"}; inner point 0; zero "none"
