jsxConditional({"kind":"Done","value":{"kind":"Some","value":7}}) => "<p>7</p>" | flip true; operand {"kind":"Done","value":{"kind":"Some","value":7}}; some 7; finally 0
jsxConditional({"kind":"Done","value":{"kind":"None"}}) => "<p></p>" | flip false; finally 0
jsxConditional({"kind":"Failed","error":"lost"}) => "<p>lost</p>" | flip true; operand {"kind":"Failed","error":"lost"}; failed "lost"; finally 0
