jsxNested({"kind":"Done","value":{"kind":"Some","value":7}}) => "<ul><li>1</li><li>7</li></ul>" | first 1; yield {"kind":"Done","value":{"kind":"Some","value":7}}; some 7
jsxNested({"kind":"Done","value":{"kind":"None"}}) => "<ul><li>1</li><li>0</li></ul>" | first 1; yield {"kind":"Done","value":{"kind":"None"}}; none 0
jsxNested({"kind":"Failed","error":"lost"}) => "<ul><li>1</li><li>lost</li></ul>" | first 1; yield {"kind":"Failed","error":"lost"}; failed "lost"
