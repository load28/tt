laterDeclarator({"kind":"Done","value":{"kind":"Some","value":7}}) => [1,7] | before 1; yield {"kind":"Done","value":{"kind":"Some","value":7}}; some 7
laterDeclarator({"kind":"Done","value":{"kind":"None"}}) => [1,0] | before 1; yield {"kind":"Done","value":{"kind":"None"}}; none 0
laterDeclarator({"kind":"Failed","error":"lost"}) => [1,"lost"] | before 1; yield {"kind":"Failed","error":"lost"}; failed "lost"
