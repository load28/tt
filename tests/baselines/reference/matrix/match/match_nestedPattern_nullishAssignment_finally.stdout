nullishAssignment({"kind":"Done","value":{"kind":"Some","value":7}}) => 7 | flip true; target {"value":null}; operand {"kind":"Done","value":{"kind":"Some","value":7}}; some 7; finally 0
nullishAssignment({"kind":"Done","value":{"kind":"None"}}) => "kept" | flip false; target {"value":"kept"}; finally 0
nullishAssignment({"kind":"Failed","error":"lost"}) => "lost" | flip true; target {"value":null}; operand {"kind":"Failed","error":"lost"}; failed "lost"; finally 0
