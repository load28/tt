nullish({"kind":"Done","value":{"kind":"Some","value":7}}) => 7 | flip true; operand {"kind":"Done","value":{"kind":"Some","value":7}}; some 7
nullish({"kind":"Done","value":{"kind":"None"}}) => "set" | flip false; left "set"
nullish({"kind":"Failed","error":"lost"}) => "lost" | flip true; operand {"kind":"Failed","error":"lost"}; failed "lost"
