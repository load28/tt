orAssignment({"kind":"Done","value":{"kind":"Some","value":7}}) => 7 | flip true; target {"value":0}; yield {"kind":"Done","value":{"kind":"Some","value":7}}; some 7
orAssignment({"kind":"Done","value":{"kind":"None"}}) => "kept" | flip false; target {"value":"kept"}
orAssignment({"kind":"Failed","error":"lost"}) => "lost" | flip true; target {"value":0}; yield {"kind":"Failed","error":"lost"}; failed "lost"
