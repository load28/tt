returnOperand({"kind":"Done","value":{"kind":"Some","value":7}}) => 7 | operand {"kind":"Done","value":{"kind":"Some","value":7}}; some 7
returnOperand({"kind":"Done","value":{"kind":"None"}}) => 0 | operand {"kind":"Done","value":{"kind":"None"}}; none 0
returnOperand({"kind":"Failed","error":"lost"}) => "lost" | operand {"kind":"Failed","error":"lost"}; failed "lost"
