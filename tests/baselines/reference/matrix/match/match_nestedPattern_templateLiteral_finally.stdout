templateLiteral({"kind":"Done","value":{"kind":"Some","value":7}}) => "<L|7|R>" | left "L"; operand {"kind":"Done","value":{"kind":"Some","value":7}}; some 7; right "R"; finally 0
templateLiteral({"kind":"Done","value":{"kind":"None"}}) => "<L|0|R>" | left "L"; operand {"kind":"Done","value":{"kind":"None"}}; none 0; right "R"; finally 0
templateLiteral({"kind":"Failed","error":"lost"}) => "<L|lost|R>" | left "L"; operand {"kind":"Failed","error":"lost"}; failed "lost"; right "R"; finally 0
