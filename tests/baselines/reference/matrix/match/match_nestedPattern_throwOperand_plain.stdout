throwOperand({"kind":"Done","value":{"kind":"Some","value":7}}) => threw 7 | operand {"kind":"Done","value":{"kind":"Some","value":7}}; some 7
throwOperand({"kind":"Done","value":{"kind":"None"}}) => threw 0 | operand {"kind":"Done","value":{"kind":"None"}}; none 0
throwOperand({"kind":"Failed","error":"lost"}) => threw "lost" | operand {"kind":"Failed","error":"lost"}; failed "lost"
