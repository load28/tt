yieldOperand({"kind":"Done","value":{"kind":"Some","value":7}}) => 7 | operand {"kind":"Done","value":{"kind":"Some","value":7}}; some 7; yield 7; finally 0
yieldOperand({"kind":"Done","value":{"kind":"None"}}) => 0 | operand {"kind":"Done","value":{"kind":"None"}}; none 0; yield 0; finally 0
yieldOperand({"kind":"Failed","error":"lost"}) => "lost" | operand {"kind":"Failed","error":"lost"}; failed "lost"; yield "lost"; finally 0
