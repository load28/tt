forTest({"kind":"Num","value":4}) => 1 | yield {"kind":"Num","value":4}; number 4
forTest({"kind":"Neg","value":-3}) => 1 | yield {"kind":"Neg","value":-3}; number -3
forTest({"kind":"Word","text":"hi"}) => 1 | yield {"kind":"Word","text":"hi"}; word "hi"
forTest({"kind":"End"}) => 0 | yield {"kind":"End"}; end ""
