matchArm({"kind":"Num","value":4}) => 4 | flip true; yield {"kind":"Num","value":4}; number 4
matchArm({"kind":"Neg","value":-3}) => 0 | flip false; other arm 0
matchArm({"kind":"Word","text":"hi"}) => "hi" | flip true; yield {"kind":"Word","text":"hi"}; word "hi"
matchArm({"kind":"End"}) => 0 | flip false; other arm 0
