templateLiteral({"kind":"Num","value":4}) => "<L|4|R>" | left "L"; operand {"kind":"Num","value":4}; number 4; right "R"
templateLiteral({"kind":"Neg","value":-3}) => "<L|-3|R>" | left "L"; operand {"kind":"Neg","value":-3}; number -3; right "R"
templateLiteral({"kind":"Word","text":"hi"}) => "<L|hi|R>" | left "L"; operand {"kind":"Word","text":"hi"}; word "hi"; right "R"
templateLiteral({"kind":"End"}) => "<L||R>" | left "L"; operand {"kind":"End"}; end ""; right "R"
