forInitializer("north") => [1] | open res; operand "north"; n 1; dispose res
forInitializer("south") => [2] | open res; operand "south"; se 2; dispose res
forInitializer("east") => [2] | open res; operand "east"; se 2; dispose res
forInitializer("up") => [0] | open res; operand "up"; other 0; dispose res
