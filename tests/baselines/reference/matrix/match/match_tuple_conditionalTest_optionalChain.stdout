conditionalTest({"kind":"Circle","r":2}) => "truthy" | second {"kind":"Fast"}; fast circle 2; then "truthy"
conditionalTest({"kind":"Rect","w":3,"h":4}) => "truthy" | second {"kind":"Fast"}; rect 3; then "truthy"
conditionalTest({"kind":"Point"}) => "truthy" | second {"kind":"Fast"}; rest -1; then "truthy"
