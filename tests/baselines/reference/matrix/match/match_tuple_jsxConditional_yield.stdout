jsxConditional({"kind":"Circle","r":2}) => "<p>2</p>" | flip true; yield {"kind":"Circle","r":2}; second {"kind":"Fast"}; fast circle 2
jsxConditional({"kind":"Rect","w":3,"h":4}) => "<p></p>" | flip false
jsxConditional({"kind":"Point"}) => "<p>-1</p>" | flip true; yield {"kind":"Point"}; second {"kind":"Fast"}; rest -1
