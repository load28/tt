templateLiteral({"kind":"Circle","r":2}) => "<L|2|R>" | left "L"; yield {"kind":"Circle","r":2}; second {"kind":"Fast"}; fast circle 2; right "R"
templateLiteral({"kind":"Rect","w":3,"h":4}) => "<L|3|R>" | left "L"; yield {"kind":"Rect","w":3,"h":4}; second {"kind":"Fast"}; rect 3; right "R"
templateLiteral({"kind":"Point"}) => "<L|-1|R>" | left "L"; yield {"kind":"Point"}; second {"kind":"Fast"}; rest -1; right "R"
