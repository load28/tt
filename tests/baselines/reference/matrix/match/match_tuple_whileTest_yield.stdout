whileTest({"kind":"Circle","r":2}) => 1 | yield {"kind":"Circle","r":2}; second {"kind":"Fast"}; fast circle 2
whileTest({"kind":"Rect","w":3,"h":4}) => 1 | yield {"kind":"Rect","w":3,"h":4}; second {"kind":"Fast"}; rect 3
whileTest({"kind":"Point"}) => 1 | yield {"kind":"Point"}; second {"kind":"Fast"}; rest -1
