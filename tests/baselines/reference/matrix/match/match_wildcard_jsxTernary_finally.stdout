jsxTernary({"kind":"Num","value":4}) => "<p>-1</p>" | flip true; operand {"kind":"Num","value":4}; other -1; finally 0
jsxTernary({"kind":"Neg","value":-3}) => "<p><i>none</i></p>" | flip false; finally 0
