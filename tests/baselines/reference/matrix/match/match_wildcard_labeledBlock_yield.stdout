labeledBlock({"kind":"Num","value":4}) => -1 | yield {"kind":"Num","value":4}; other -1; flip true
labeledBlock({"kind":"Neg","value":-3}) => [-1] | yield {"kind":"Neg","value":-3}; other -1; flip false
labeledBlock({"kind":"Word","text":"hi"}) => 2 | yield {"kind":"Word","text":"hi"}; word 2; flip true
labeledBlock({"kind":"End"}) => [-1] | yield {"kind":"End"}; other -1; flip false
