switchDiscriminant({"kind":"Num","value":4}) => "default" | yield {"kind":"Num","value":4}; other -1; case 0
switchDiscriminant({"kind":"Neg","value":-3}) => "default" | yield {"kind":"Neg","value":-3}; other -1; case 0
switchDiscriminant({"kind":"Word","text":"hi"}) => "default" | yield {"kind":"Word","text":"hi"}; word 2; case 0
