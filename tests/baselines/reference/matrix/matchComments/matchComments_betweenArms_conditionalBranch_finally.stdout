conditionalBranch({"kind":"Circle","r":2}) => 4 | flip true; operand {"kind":"Circle","r":2}; circle 4; finally 0
conditionalBranch({"kind":"Rect","w":3,"h":4}) => "skipped" | flip false; else "skipped"; finally 0
conditionalBranch({"kind":"Point"}) => 0 | flip true; operand {"kind":"Point"}; point 0; finally 0
