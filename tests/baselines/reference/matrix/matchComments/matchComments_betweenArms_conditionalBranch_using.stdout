conditionalBranch({"kind":"Circle","r":2}) => 4 | open res; flip true; operand {"kind":"Circle","r":2}; circle 4; dispose res
conditionalBranch({"kind":"Rect","w":3,"h":4}) => "skipped" | open res; flip false; else "skipped"; dispose res
conditionalBranch({"kind":"Point"}) => 0 | open res; flip true; operand {"kind":"Point"}; point 0; dispose res
