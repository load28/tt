conditionalTest({"kind":"Circle","r":2}) => "truthy" | open res; operand {"kind":"Circle","r":2}; circle 4; then "truthy"; dispose res
conditionalTest({"kind":"Rect","w":3,"h":4}) => "truthy" | open res; operand {"kind":"Rect","w":3,"h":4}; rect 12; then "truthy"; dispose res
conditionalTest({"kind":"Point"}) => "falsy" | open res; operand {"kind":"Point"}; point 0; else "falsy"; dispose res
