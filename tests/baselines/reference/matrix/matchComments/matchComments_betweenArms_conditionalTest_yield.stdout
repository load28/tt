conditionalTest({"kind":"Circle","r":2}) => "truthy" | yield {"kind":"Circle","r":2}; circle 4; then "truthy"
conditionalTest({"kind":"Rect","w":3,"h":4}) => "truthy" | yield {"kind":"Rect","w":3,"h":4}; rect 12; then "truthy"
conditionalTest({"kind":"Point"}) => "falsy" | yield {"kind":"Point"}; point 0; else "falsy"
