jsxAttribute({"kind":"Circle","r":2}) => "<div data-value=4></div>" | yield {"kind":"Circle","r":2}; circle 4
jsxAttribute({"kind":"Rect","w":3,"h":4}) => "<div data-value=12></div>" | yield {"kind":"Rect","w":3,"h":4}; rect 12
jsxAttribute({"kind":"Point"}) => "<div data-value=0></div>" | yield {"kind":"Point"}; point 0
