jsxSpreadAttribute({"kind":"Circle","r":2}) => "<div value=4></div>" | yield {"kind":"Circle","r":2}; circle 4
jsxSpreadAttribute({"kind":"Rect","w":3,"h":4}) => "<div value=12></div>" | yield {"kind":"Rect","w":3,"h":4}; rect 12
jsxSpreadAttribute({"kind":"Point"}) => "<div value=0></div>" | yield {"kind":"Point"}; point 0
