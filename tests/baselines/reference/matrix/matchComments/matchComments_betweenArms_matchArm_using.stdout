matchArm({"kind":"Circle","r":2}) => 4 | open res; flip true; operand {"kind":"Circle","r":2}; circle 4; dispose res
matchArm({"kind":"Rect","w":3,"h":4}) => 0 | open res; flip false; other arm 0; dispose res
matchArm({"kind":"Point"}) => 0 | open res; flip true; operand {"kind":"Point"}; point 0; dispose res
