whileTest({"kind":"Circle","r":2}) => 1 | open res; operand {"kind":"Circle","r":2}; circle 4; dispose res
whileTest({"kind":"Rect","w":3,"h":4}) => 1 | open res; operand {"kind":"Rect","w":3,"h":4}; rect 12; dispose res
whileTest({"kind":"Point"}) => 0 | open res; operand {"kind":"Point"}; point 0; dispose res
