conditionalBranch(3) => {"kind":"Ok","value":3} | open res; flip true; operand 3; read 3; big 3; dispose res
conditionalBranch(1) => "skipped" | open res; flip false; else "skipped"; dispose res
conditionalBranch(-1) => {"kind":"Err","error":"negative -1"} | open res; flip true; operand -1; read -1; dispose res
