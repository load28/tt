jsxSpreadAttribute(3) => "<div value={'kind':'Ok','value':3}></div>" | operand 3; read 3; big 3; finally 0
jsxSpreadAttribute(1) => "<div value={'kind':'Ok','value':1}></div>" | operand 1; read 1; small 1; finally 0
jsxSpreadAttribute(-1) => "<div value={'kind':'Err','error':'negative -1'}></div>" | operand -1; read -1; finally 0
