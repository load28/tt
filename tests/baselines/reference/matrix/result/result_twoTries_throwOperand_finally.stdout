throwOperand(5) => threw {"kind":"Ok","value":[5,2]} | operand 5; read 5; b 2; read 2; finally 0
throwOperand(1) => threw {"kind":"Err","error":"negative -2"} | operand 1; read 1; b -2; read -2; finally 0
throwOperand(-2) => threw {"kind":"Err","error":"negative -2"} | operand -2; read -2; finally 0
