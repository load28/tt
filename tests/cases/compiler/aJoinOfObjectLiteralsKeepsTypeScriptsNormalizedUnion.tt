// @run: main.tt
// @filename: main.tt
variant O { A(n: number), B }
function f(o: O) {
  const x = match (o) { A(n) => ({ a: n }), B => ({ b: "x" }) };
  return [x.a, x.b];
}
function g(o: O) {
  const y = match (o) { A(n) => ({ inner: { p: n } }), B => ({ inner: { q: "y" } }) };
  return [y.inner.p, y.inner.q];
}
console.log(JSON.stringify([f(O.A(1)), f(O.B), g(O.A(2)), g(O.B)]));
