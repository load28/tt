// Repro from TASK-593
// @run: declaratorListLaterValue.tt
variant O { A(n: number), B }
function pick(n: number): O {
  return n > 0 ? O.A(n) : O.B;
}
const o = pick(1);
function t(s: string): number {
  console.log(`t ${s}`);
  return 10;
}
export function f() {
  const a = t("a"), b = match (o) { A(n) => a + n, B => 0 };
  return b;
}
export function g() {
  var a = 10, b = match (o) { A(n) => a + n, B => 0 };
  return b;
}
console.log(`f ${f()}`);
console.log(`g ${g()}`);
