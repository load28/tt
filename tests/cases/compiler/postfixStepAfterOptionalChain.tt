// A postfix step applies to the value its head (or the step before it)
// evaluates to. When that value is an optional chain, the step must not
// join the chain: `box?.v |> .toFixed(1)` is `(box?.v).toFixed(1)`, which
// throws when `box` is undefined, not `box?.v.toFixed(1)`, which yields
// undefined (ECMA-262 §13.3.9: a parenthesized expression ends the chain).
// The step's type is then the member's own, without `| undefined`. The
// twin is the same program written as TypeScript.
// @run: main.tt
// @twin: twin.ts
// @filename: main.tt
export {};
function box(present: boolean): { inner: { value: number } } | undefined {
  return present ? { inner: { value: 1.25 } } : undefined;
}
function loose(present: boolean): any {
  return present ? " a " : undefined;
}
function attempt(label: string, run: () => unknown): void {
  try {
    console.log(label, JSON.stringify(run()));
  } catch (error) {
    console.log(label, "threw", error instanceof TypeError);
  }
}
function fixed(present: boolean): string {
  return box(present)?.inner.value! |> .toFixed(1);
}
for (const present of [true, false]) {
  attempt("head", () => fixed(present));
  attempt("member", () => box(present)?.inner! |> .value |> String);
  attempt("tail", () => loose(present) |> ?.trim() |> .length);
}
// @filename: twin.ts
export {};
function box(present: boolean): { inner: { value: number } } | undefined {
  return present ? { inner: { value: 1.25 } } : undefined;
}
function loose(present: boolean): any {
  return present ? " a " : undefined;
}
function attempt(label: string, run: () => unknown): void {
  try {
    console.log(label, JSON.stringify(run()));
  } catch (error) {
    console.log(label, "threw", error instanceof TypeError);
  }
}
function fixed(present: boolean): string {
  return (box(present)?.inner.value!).toFixed(1);
}
for (const present of [true, false]) {
  attempt("head", () => fixed(present));
  attempt("member", () => String((box(present)?.inner!).value));
  attempt("tail", () => (loose(present)?.trim()).length);
}
