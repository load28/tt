const half = (n: number) => n / 2;
const scale = { by: (n: number) => n * 3 } as { by(n: number): number } | undefined;
export function make() {
  const label = flow |> half |> .toFixed(1);
  const scaled = flow |> ((n: number) => scale?.by(n)) |> String;
  return [label, scaled];
}
