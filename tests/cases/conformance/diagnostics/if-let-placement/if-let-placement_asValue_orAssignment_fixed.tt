import { note, flip, read, drive } from "./harness.js";
const inputs: number[] = [2, -1];
function probe(input: number) {
  let lifted: number;
  if let Ok(value: n) = read(note("operand", input)) { lifted = note("then", n); } else { lifted = note("else", 0); }
  const target = { value: (flip() ? 0 : "kept") as unknown };
  note("target", target).value ||= lifted;
  return target.value;
}
await drive("orAssignment", probe, inputs);
