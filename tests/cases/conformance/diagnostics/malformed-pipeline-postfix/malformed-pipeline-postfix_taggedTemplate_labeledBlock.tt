import { note, flip, drive } from "./harness.js";
const inputs: number[] = [1.25, 2];
function probe(input: number) {
  let collected: unknown = "none";
  found: {
    collected = note("operand", input) |> ?.toFixed[|`1`|];
    if (flip()) break found;
    collected = [collected];
  }
  return collected;
}
await drive("labeledBlock", probe, inputs);
