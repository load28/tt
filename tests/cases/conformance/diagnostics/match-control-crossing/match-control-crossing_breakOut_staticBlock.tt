import { note, drive } from "./harness.js";
const inputs: number[] = [1, 2];
function probe(input: number) {
  class Holder {
    static field: unknown = "none";
    static {
      let seen: unknown = "none";
      for (const round of [1, 2]) { const v = match (note("operand", input)) { 1 => { if (round > 1) [|break|]; return note("one", round); }, _ => note("other", round) }; seen = v; }
      Holder.field = seen;
    }
  }
  return Holder.field;
}
await drive("staticBlock", probe, inputs);
