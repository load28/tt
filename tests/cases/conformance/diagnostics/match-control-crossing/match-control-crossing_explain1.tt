export variant Item { Stop, Keep(value: number) }
export function sum(items: Item[]) {
  let total = 0;
  for (const item of items) {
    total += match (item) {
      Stop => { if (total > 9) [|break|]; return 0; },
      Keep(value) => value,
    };
  }
  return total;
}
