export variant Maybe { Some(value: number), None }
export variant Outcome { Ok(value: Maybe), Err(error: string) }
export function value(o: Outcome) {
  return (
    match (o) {
      [|Ok|](value: None()) | Err => 0,
      _ => -1,
    }
  );
}
