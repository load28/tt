import { note, drive } from "./harness.js";
variant Maybe { Some(value: number), None }
variant Outcome { Done(value: Maybe), Failed(error: string) }
const inputs: Outcome[] = [Outcome.Done(Maybe.Some(7)), Outcome.Done(Maybe.None), Outcome.Failed("lost")];
function probe(input: Outcome) {
  let rounds = 0;
  for (; rounds < 1 && match (note("operand", input)) { [|Done|](value: None()) | Failed => note("hit", 0), _ => note("other", 1) }; ) {
    rounds++;
  }
  return rounds;
}
await drive("forTest", probe, inputs);
