import { note, pack, drive } from "./harness.js";
variant Shape { Circle(r: number), Rect(w: number, h: number), Point }
const inputs: Shape[] = [Shape.Circle(2), Shape.Rect(3, 4), Shape.Point];
function probe(input: Shape) {
  return pack(note("a", 1), match (note("operand", input)) { Circle(r) => note("size", r), Rect(w) => note("size", w), Point => note("point", 0) }, note("c", 3));
}
await drive("callArgument", probe, inputs);
