import { note, drive } from "./harness.js";
variant Shape { Circle(r: number), Rect(w: number, h: number), Point }
const inputs: Shape[] = [Shape.Circle(2), Shape.Rect(3, 4), Shape.Point];
function probe(input: Shape) {
  const receiver = { tag: "receiver", take(...items: unknown[]) { return [this.tag, ...items]; } };
  return note("receiver", receiver).take(note("a", 1), match (note("operand", input)) { Circle(r) | [|Rect|](w) => note("size", 0), Point => note("point", 0) });
}
await drive("methodArgument", probe, inputs);
