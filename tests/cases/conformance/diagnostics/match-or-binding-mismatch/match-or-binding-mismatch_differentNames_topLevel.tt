variant Shape { Circle(r: number), Rect(w: number, h: number), Point }
const inputs: Shape[] = [Shape.Circle(2), Shape.Rect(3, 4), Shape.Point];
let input: Shape = inputs[0]!;
const top0 = match (note("operand", input)) { Circle(r) | [|Rect|](w) => note("size", 0), Point => note("point", 0) };
report("topLevel", input, text(top0));
input = inputs[1]!;
