import { note, flip, drive } from "./harness.js";
variant Dir { Up, Down }
const inputs: Dir[] = [Dir.Up, Dir.Down];
function probe(input: Dir) {
  return (flip() ? null : note("left", "set")) ?? match (note("operand", input), note<Dir>("second", Dir.Up)) { (Up, Down) => note("ud", 0), (Up, _) => note("u", 1), _ => note("other", 2) };
}
await drive("nullish", probe, inputs);
