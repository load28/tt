import { note, flip, drive } from "./harness.js";
type Dir = { kind: "Up" } | { kind: "Down" };
const Dir = {
  Up: { kind: "Up" } as Dir,
  Down: { kind: "Down" } as Dir,
};
let t0: any, t1: any;
const inputs: Dir[] = [Dir.Up, Dir.Down];
function probe(input: Dir) {
  return (flip() ? null : note("left", "set")) ?? (t0 = note("operand", input), t1 = note<Dir>("second", Dir.Up), t0.kind === "Up" && t1.kind === "Down" ? note("ud", 0) : t0.kind === "Up" ? note("u", 1) : note("other", 2));
}
await drive("nullish", probe, inputs);
