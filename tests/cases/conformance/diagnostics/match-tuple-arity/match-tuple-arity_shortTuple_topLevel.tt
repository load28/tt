// @filename: harness.ts
export const out: string[] = [];
export function text(value: unknown): string {
  if (typeof value === "bigint") return `${value}n`;
  if (typeof value === "function") return "function";
  if (value === undefined) return "undefined";
  return JSON.stringify(value);
}
export function note<T>(label: string, value: T): T {
  out.push(`${label} ${text(value)}`);
  return value;
}
export function report(title: string, input: unknown, shown: string): void {
  console.log(`${title}(${text(input)}) => ${shown} | ${out.join("; ")}`);
  out.length = 0;
}
// @filename: main.tt
import { text, note, report } from "./harness.js";
variant Dir { Up, Down }
const inputs: Dir[] = [Dir.Up, Dir.Down];
let input: Dir = inputs[0]!;
const top0 = match (note("operand", input), note<Dir>("second", Dir.Up)) { (Up, Down) => note("ud", 0), [|(Up)|] => note("u", 1), _ => note("other", 2) };
report("topLevel", input, text(top0));
input = inputs[1]!;
const top1 = match (note("operand", input), note<Dir>("second", Dir.Up)) { (Up, Down) => note("ud", 0), [|(Up)|] => note("u", 1), _ => note("other", 2) };
report("topLevel", input, text(top1));
