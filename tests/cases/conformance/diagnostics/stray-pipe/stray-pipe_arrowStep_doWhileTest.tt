import { note, drive } from "./harness.js";
const inputs: number[] = [1, 2];
function probe(input: number) {
  let rounds = 0;
  do {
    rounds++;
  } while (rounds < 2 && (note("operand", input) [||>|] (n: number) => note("step", n + 1)));
  return rounds;
}
await drive("doWhileTest", probe, inputs);
