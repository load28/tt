declare function read(n: number): { kind: "Ok"; value: number } | { kind: "Err"; error: string };
export function total(xs: number[]) {
  let sum = 0;
  for (let i = 0; i < [|try read(xs.length)|]; i++) {
    sum += xs[i]!;
  }
  return sum;
}
