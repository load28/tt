import { note, drive } from "./harness.js";
variant Disk { Round(radius: number), Dot }
const inputs: Disk[] = [Disk.Round(2), Disk.Dot];
async function probe(input: Disk) {
  return await (match (note("operand", input)) { Round(radius) => note("round", radius), Dot => note("dot", 0) });
}
await drive("awaitOperand", probe, inputs);
