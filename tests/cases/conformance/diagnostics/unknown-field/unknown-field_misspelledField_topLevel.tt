import { text, note, report } from "./harness.js";
variant Disk { Round(radius: number), Dot }
const inputs: Disk[] = [Disk.Round(2), Disk.Dot];
let input: Disk = inputs[0]!;
const top0 = match (note("operand", input)) { Round([|radiu|]) => note("round", radiu), Dot => note("dot", 0) };
report("topLevel", input, text(top0));
input = inputs[1]!;
const top1 = match (note("operand", input)) { Round([|radiu|]) => note("round", radiu), Dot => note("dot", 0) };
report("topLevel", input, text(top1));
