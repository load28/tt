const xs = [3];
let j = 0;
const seen: number[] = [];
for (; j < match (xs[0]) { 3 => 3, _ => 0 };) { seen.push(j); j++; }
for (let k = 0; k < match (xs[0]) { 3 => 2, _ => 0 }; k++) { seen.push(10 + k); }
console.log(JSON.stringify(seen));

export {};
