// @origin: tests/integration/cases_05.rs::a_loop_header_match_is_evaluated_every_iteration
// @run: aLoopHeaderMatchIsEvaluatedEveryIteration.tt

let n = 0;
function next(): number { n = n + 1; return n; }
function id(v: number): number { return v; }
const seen: number[] = [];
while (id(match (next()) { 1 => 1, 2 => 1, _ => 0 })) {
  seen.push(n);
}
console.log(JSON.stringify(seen), n);

export {};
