import type { TResult } from "./tt/index.js";
import * as Result from "./tt/result.js";

declare function getUser(): TResult<number, { tag: "user" }>;

function load(): TResult<number, string> {
  const user = try getUser();
  return Result.Ok(user);
}

console.log(load());

