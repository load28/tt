import { note, later, adder, drive } from "./harness.js";
const inputs: number[] = [3, -4];
async function probe(input: number) {
  let collected: unknown = "none";
  switch (flow |> adder(await later(input)) |> String) {
    case note("case", 0 as unknown):
    collected = "zero";
    break;
    default:
    collected = "default";
  }
  return collected;
}
await drive("switchDiscriminant", probe, inputs);
