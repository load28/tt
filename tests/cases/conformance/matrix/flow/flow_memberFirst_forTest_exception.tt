import { note, risky, adder, tools, drive } from "./harness.js";
const inputs: number[] = [2, 7];
function probe(input: number) {
  try {
    let rounds = 0;
    for (; rounds < 1 && (flow |> note("receiver", tools).twice |> adder(risky(input))); ) {
      rounds++;
    }
    return rounds;
  } catch (error) {
    return note("caught", (error as Error).message);
  }
}
await drive("forTest", probe, inputs);
