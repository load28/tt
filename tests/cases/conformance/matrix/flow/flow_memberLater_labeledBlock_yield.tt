import { note, flip, adder, tools, drive } from "./harness.js";
const inputs: number[] = [2, 3];
function* probe(input: number): Generator<unknown, unknown, number> {
  let collected: unknown = "none";
  found: {
    collected = flow |> adder((yield input)) |> note("receiver", tools).twice;
    if (flip()) break found;
    collected = [collected];
  }
  return collected;
}
await drive("labeledBlock", probe, inputs);
