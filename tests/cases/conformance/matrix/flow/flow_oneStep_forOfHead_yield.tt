import { adder, drive } from "./harness.js";
const inputs: number[] = [7, 1];
function* probe(input: number): Generator<unknown, unknown, number> {
  const collected: unknown[] = [];
  for (const item of [flow |> adder((yield input))]) {
    collected.push(item);
  }
  return collected;
}
await drive("forOfHead", probe, inputs);
