import { note, flip, risky, adder, maybe, drive } from "./harness.js";
const inputs: number[] = [4, 6, 8];
function probe(input: number) {
  try {
    const collected: unknown[] = [];
    for (const item of [flow |> adder(risky(input)) |> maybe(flip())?.twice]) {
      collected.push(item);
    }
    return collected;
  } catch (error) {
    return note("caught", (error as Error).message);
  }
}
await drive("forOfHead", probe, inputs);
