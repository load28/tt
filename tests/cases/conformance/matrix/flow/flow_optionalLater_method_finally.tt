}
let flips = 0;
export function flip(): boolean {
  return note("flip", flips++ % 2 === 0);
}
export function first<T>(...items: T[]): T {
  return items[0]!;
}
export const adder = (a: number) => (b: number): number => note("add", a + b);
export const tools = {
  factor: 3,
