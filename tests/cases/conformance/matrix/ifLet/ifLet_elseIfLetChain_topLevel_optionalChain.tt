import { text, note, box, read, report } from "./harness.js";
const inputs: number[] = [4, -4];
let input: number = inputs[0]!;
let seen: unknown = "none";
if let Ok(value: v) = read(box(input)?.inner.value!) { seen = note("first", v); } else if let Err(error) = read(note("second", -2)) { seen = note("second", error); } else { seen = "neither"; }
report("topLevel", input, text(seen));
