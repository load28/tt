import { note, box, read, drive } from "./harness.js";
const inputs: number[] = [2, -2];
function probe(input: number) {
  const value = match (note<boolean>("arm", true)) {
    true => {
      if let Err(error) = read(box(input)?.inner.value!) { note("error", error); throw new Error("diverged"); }
      return "passed";
    },
    false => "other",
  };
  return value;
}
await drive("matchBlockArm", probe, inputs);
