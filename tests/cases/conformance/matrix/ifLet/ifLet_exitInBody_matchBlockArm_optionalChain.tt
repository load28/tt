import { note, box, read, drive } from "./harness.js";
const inputs: number[] = [2, -2];
function probe(input: number) {
  note<boolean>("arm", true);
  const value = (() => {
      { const t0 = read(box(input)?.inner.value!);
        if (t0.kind === "Err") { const error = t0.error; note("error", error); throw new Error("diverged"); } }
      return "passed";
  })();
  return value;
}
await drive("matchBlockArm", probe, inputs);
