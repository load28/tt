import { text, note, later, read, report } from "./harness.js";
const inputs: number[] = [2, -2];
let input: number = inputs[0]!;
if let Err(error) = read(await later(input)) { note("error", error); throw new Error("diverged"); }
report("topLevel", input, text("passed"));
