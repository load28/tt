import { note, later, drive } from "./harness.js";
type Maybe = { kind: "Some"; value: number } | { kind: "None" };
const Maybe = {
  Some: (value: number): Maybe => ({ kind: "Some" as const, value }),
  None: { kind: "None" } as Maybe,
};
type Outcome = { kind: "Done"; value: Maybe } | { kind: "Failed"; error: string };
const Outcome = {
  Done: (value: Maybe): Outcome => ({ kind: "Done" as const, value }),
  Failed: (error: string): Outcome => ({ kind: "Failed" as const, error }),
};
const inputs: Outcome[] = [Outcome.Done(Maybe.Some(5)), Outcome.Done(Maybe.None), Outcome.Failed("gone")];
async function probe(input: Outcome) {
  let seen: unknown = "none";
  { const t0 = await later(input);
    if (t0.kind === "Done" && t0.value.kind === "Some") { const v = t0.value.value; seen = note("some", v); } else { seen = "other"; } }
  return seen;
}
await drive("functionBody", probe, inputs);
