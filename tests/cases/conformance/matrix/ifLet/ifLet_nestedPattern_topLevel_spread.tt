import { text, note, first, report } from "./harness.js";
variant Maybe { Some(value: number), None }
variant Outcome { Done(value: Maybe), Failed(error: string) }
const inputs: Outcome[] = [Outcome.Done(Maybe.Some(5)), Outcome.Done(Maybe.None), Outcome.Failed("gone")];
let input: Outcome = inputs[0]!;
let seen: unknown = "none";
if let Done(value: Some(value: v)) = first(...[input]) { seen = note("some", v); } else { seen = "other"; }
report("topLevel", input, text(seen));
