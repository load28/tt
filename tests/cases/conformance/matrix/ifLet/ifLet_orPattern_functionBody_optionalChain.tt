import { text, note, box, drive } from "./harness.js";
type Token = { kind: "Num"; value: number } | { kind: "Neg"; value: number } | { kind: "Word"; text: string };
const Token = {
  Num: (value: number): Token => ({ kind: "Num" as const, value }),
  Neg: (value: number): Token => ({ kind: "Neg" as const, value }),
  Word: (text: string): Token => ({ kind: "Word" as const, text }),
};
const inputs: Token[] = [Token.Num(1), Token.Neg(-1), Token.Word("w")];
function probe(input: Token) {
  let seen: unknown = "none";
  { const t0 = box(input)?.inner.value!;
    if (t0.kind === "Num" || t0.kind === "Neg") { const value = t0.value; seen = note("number", value); } }
  return seen;
}
await drive("functionBody", probe, inputs);
