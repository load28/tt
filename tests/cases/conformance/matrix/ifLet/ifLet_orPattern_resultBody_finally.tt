import { text, note, read, drive } from "./harness.js";
variant Token { Num(value: number), Neg(value: number), Word(text: string) }
const inputs: Token[] = [Token.Num(1), Token.Neg(-1), Token.Word("w")];
function probe(input: Token) {
  try {
    const block = result {
      const base = try read(note("base", 1));
      let seen: unknown = "none";
      if let Num(value) | Neg(value) = note("operand", input) { seen = note("number", value); }
      return [base, seen];
    };
    return block;
  } finally {
    note("finally", 0);
  }
}
await drive("resultBody", probe, inputs);
