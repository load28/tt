import { note, read, drive } from "./harness.js";
const inputs: number[] = [3, -3];
function probe(input: number) {
  try {
    try {
      throw new Error(note("throw", "boom"));
    } catch (error) {
      let seen: unknown = "none";
      if let Ok(value: v) = read(note("operand", input)) { seen = note("then", v); } else { seen = note("else", "missing"); }
      return seen;
    }
  } finally {
    note("finally", 0);
  }
}
await drive("catchBlock", probe, inputs);
