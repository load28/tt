import { later, drive } from "./harness.js";
type Shape = { kind: "Circle"; r: number } | { kind: "Rect"; w: number; h: number } | { kind: "Point" };
const Shape = {
  Circle: (r: number): Shape => ({ kind: "Circle" as const, r }),
  Rect: (w: number, h: number): Shape => ({ kind: "Rect" as const, w, h }),
  Point: { kind: "Point" } as Shape,
};
const inputs: Shape[] = [Shape.Rect(2, 3), Shape.Circle(1), Shape.Point];
function probe(input: Shape) {
  const inner = async (input: Shape) => {
    const t0 = await later(input);
    if (t0.kind !== "Rect") { return "diverged"; }
    const height = t0.h, width = t0.w;
    return [width, height];
  };
  return inner(input);
}
await drive("arrowBlock", probe, inputs);
