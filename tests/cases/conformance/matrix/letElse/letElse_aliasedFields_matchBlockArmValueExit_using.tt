import { note, resource, drive } from "./harness.js";
variant Shape { Circle(r: number), Rect(w: number, h: number), Point }
const inputs: Shape[] = [Shape.Rect(2, 3), Shape.Circle(1), Shape.Point];
function probe(input: Shape) {
  using res = resource("res");
  const value = match (note<boolean>("arm", true)) {
    true => {
      const Rect(h: height, w: width) = note("operand", input) else { return match (note("exit", 3)) { 3 => "three", _ => "other" }; };
      return [width, height];
    },
    false => "other",
  };
  return value;
}
await drive("matchBlockArmValueExit", probe, inputs);
