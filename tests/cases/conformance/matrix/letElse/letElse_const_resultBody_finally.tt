import { note, ok, read, unwrap, caught, drive } from "./harness.js";
const inputs: number[] = [2, -1];
function probe(input: number) {
  try {
    const block = (() => {
        try {
          const base = unwrap(read(note("base", 1)));
          const t0 = read(note("operand", input));
          if (t0.kind !== "Ok") { return ok(base); }
          const v = t0.value;
          return ok([base, v]);
