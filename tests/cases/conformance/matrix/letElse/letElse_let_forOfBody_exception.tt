import { note, risky, read, drive } from "./harness.js";
const inputs: number[] = [3, -3];
function probe(input: number) {
  try {
    const collected: unknown[] = [];
    for (const round of [0, 1]) {
      note("round", round);
      const t0 = read(risky(input));
      if (t0.kind !== "Ok") { continue; }
      let v = t0.value;
      v = note("reassigned", v + 1);
      collected.push(v);
    }
    return collected;
  } catch (error) {
    return note("caught", (error as Error).message);
  }
}
await drive("forOfBody", probe, inputs);
