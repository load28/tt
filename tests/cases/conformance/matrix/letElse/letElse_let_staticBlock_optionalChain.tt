import { note, box, read, drive } from "./harness.js";
const inputs: number[] = [3, -3];
function probe(input: number) {
  class Holder {
    static field: unknown = "none";
    static {
      let Ok(value: v) = read(box(input)?.inner.value!) else { throw new Error("diverged"); };
      v = note("reassigned", v + 1);
      Holder.field = v;
    }
  }
  return Holder.field;
}
await drive("staticBlock", probe, inputs);
// @filename: twin.ts
import { note, box, read, drive } from "./harness.js";
const inputs: number[] = [3, -3];
function probe(input: number) {
  class Holder {
    static field: unknown = "none";
    static {
      const t0 = read(box(input)?.inner.value!);
      if (t0.kind !== "Ok") { throw new Error("diverged"); }
      let v = t0.value;
      v = note("reassigned", v + 1);
      Holder.field = v;
    }
  }
  return Holder.field;
}
await drive("staticBlock", probe, inputs);
