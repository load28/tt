import { note, first, drive } from "./harness.js";
const inputs: number[] = [7, 8];
function probe(input: number) {
  try {
    throw new Error(note("throw", "boom"));
  } catch (error) {
    const Some(value: v) = { kind: "Some" as const, value: first(...[input]) } else { return "diverged"; };
    return v;
  }
}
await drive("catchBlock", probe, inputs);
