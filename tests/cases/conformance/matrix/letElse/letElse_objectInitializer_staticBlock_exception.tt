import { note, risky, drive } from "./harness.js";
const inputs: number[] = [7, 8];
function probe(input: number) {
  try {
    class Holder {
      static field: unknown = "none";
      static {
        const Some(value: v) = { kind: "Some" as const, value: risky(input) } else { throw new Error("diverged"); };
        Holder.field = v;
      }
    }
    return Holder.field;
  } catch (error) {
    return note("caught", (error as Error).message);
  }
}
await drive("staticBlock", probe, inputs);
