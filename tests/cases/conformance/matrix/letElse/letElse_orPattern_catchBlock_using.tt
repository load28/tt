import { text, note, resource, drive } from "./harness.js";
type Token = { kind: "Num"; value: number } | { kind: "Neg"; value: number } | { kind: "Word"; text: string };
const Token = {
  Num: (value: number): Token => ({ kind: "Num" as const, value }),
  Neg: (value: number): Token => ({ kind: "Neg" as const, value }),
  Word: (text: string): Token => ({ kind: "Word" as const, text }),
};
const inputs: Token[] = [Token.Num(1), Token.Neg(-2), Token.Word("w")];
function probe(input: Token) {
  using res = resource("res");
  try {
    throw new Error(note("throw", "boom"));
  } catch (error) {
    const t0 = note("operand", input);
    if (t0.kind !== "Num" && t0.kind !== "Neg") { return "diverged"; }
    const value = t0.value;
    return value;
  }
}
await drive("catchBlock", probe, inputs);
