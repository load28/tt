import { text, note, resource, drive } from "./harness.js";
variant Token { Num(value: number), Neg(value: number), Word(text: string) }
const inputs: Token[] = [Token.Num(1), Token.Neg(-2), Token.Word("w")];
function probe(input: Token) {
  using res = resource("res");
  try {
    throw new Error(note("throw", "boom"));
  } catch (error) {
    const Num(value) | Neg(value) = note("operand", input) else { return "diverged"; };
    return value;
  }
}
await drive("catchBlock", probe, inputs);
