import { text, first, drive } from "./harness.js";
variant Token { Num(value: number), Neg(value: number), Word(text: string) }
const inputs: Token[] = [Token.Num(1), Token.Neg(-2), Token.Word("w")];
function probe(input: Token) {
  class Holder {
    field: unknown = "none";
    constructor(input: Token) {
      const Num(value) | Neg(value) = first(...[input]) else { throw new Error("diverged"); };
      this.field = value;
    }
  }
  return new Holder(input).field;
}
await drive("constructorBody", probe, inputs);
