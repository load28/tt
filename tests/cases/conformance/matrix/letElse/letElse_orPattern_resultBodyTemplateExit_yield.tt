import { text, note, read, drive } from "./harness.js";
variant Token { Num(value: number), Neg(value: number), Word(text: string) }
const inputs: Token[] = [Token.Num(1), Token.Neg(-2), Token.Word("w")];
function* probe(input: Token): Generator<unknown, unknown, Token> {
  const block = result {
    const base = try read(note("base", 1));
    const Num(value) | Neg(value) = (yield input) else { return `<${match (base) { 1 => "one", _ => "many" }}>`; };
    return [base, value];
  };
  return block;
}
await drive("resultBodyTemplateExit", probe, inputs);
