import { note, flip, risky, drive } from "./harness.js";
variant Shape { Circle(r: number), Rect(w: number, h: number), Point }
const inputs: Shape[] = [Shape.Circle(2), Shape.Rect(3, 4), Shape.Point];
function probe(input: Shape) {
  try {
    return match (flip()) { true => match (risky(input)) { Rect(w, h) => { const area = note("area", w * h); if (area > 10) { return note("large", area); } return note("small", area); }, _ => note("other", 0) }, false => note("other arm", 0) };
  } catch (error) {
    return note("caught", (error as Error).message);
  }
}
await drive("matchArm", probe, inputs);
