import { note, drive } from "./harness.js";
variant Shape { Circle(r: number), Rect(w: number, h: number), Point }
const inputs: Shape[] = [Shape.Circle(2), Shape.Rect(3, 4), Shape.Point];
function probe(input: Shape) {
  let collected: unknown = "none";
  switch (note("discriminant", 0) as unknown) {
    case match (note("operand", input)) { Rect(w, h) => { const area = note("area", w * h); if (area > 10) { return note("large", area); } return note("small", area); }, _ => note("other", 0) }:
    collected = "matched";
    break;
    default:
    collected = "default";
  }
  return collected;
}
await drive("switchCaseTest", probe, inputs);
