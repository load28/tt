import { note, flip, box, drive } from "./harness.js";
const inputs: boolean[] = [true, false];
function probe(input: boolean) {
  let slot: unknown = flip() ? null : "kept";
  return [(slot ??= match (box(input)?.inner.value!) { true => note("yes", 1), false => note("no", 0) }), slot];
