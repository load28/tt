import { note, first, drive } from "./harness.js";
const inputs: boolean[] = [true, false];
function probe(input: boolean) {
  function inner(value: unknown = match (first(...[input])) { true => note("yes", 1), false => note("no", 0) }) {
    return value;
  }
  return inner();
}
await drive("parameterDefault", probe, inputs);
