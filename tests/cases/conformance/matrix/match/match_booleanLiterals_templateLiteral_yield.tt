import { note, drive } from "./harness.js";
const inputs: boolean[] = [true, false];
function* probe(input: boolean): Generator<unknown, unknown, boolean> {
  return `<${note("left", "L")}|${match ((yield input)) { true => note("yes", 1), false => note("no", 0) }}|${note("right", "R")}>`;
}
await drive("templateLiteral", probe, inputs);
