import { note, box, drive } from "./harness.js";
variant Shape { Circle(r: number), Rect(w: number, h: number), Point }
const inputs: Shape[] = [Shape.Circle(2), Shape.Rect(3, 4), Shape.Point];
function probe(input: Shape) {
  return `<${note("left", "L")}|${match (box(input)?.inner.value!) { Rect(h: tall, w: wide) => note("rect", [wide, tall]), Circle(r: radius) => note("circle", radius), Point => note("point", null) }}|${note("right", "R")}>`;
}
await drive("templateLiteral", probe, inputs);
