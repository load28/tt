import { note, flip, first, drive } from "./harness.js";
variant Shape { Circle(r: number), Rect(w: number, h: number), Point }
const inputs: Shape[] = [Shape.Circle(1), Shape.Circle(5), Shape.Rect(4, 2), Shape.Rect(1, 3), Shape.Point];
function probe(input: Shape) {
  const target = { value: (flip() ? 0 : "kept") as unknown };
  note("target", target).value &&= match (first(...[input])) { Circle(r) if note("guard big", r > 2) => note("big", r), Circle(r) => note("small", r), Rect(w, h) if note("guard wide", w > h) => note("wide", w), Rect(w, h) => note("tall", h), Point => note("point", 0) };
  return target.value;
}
await drive("andAssignment", probe, inputs);
