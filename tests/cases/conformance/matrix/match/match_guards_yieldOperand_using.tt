import { note, resource, drive } from "./harness.js";
variant Shape { Circle(r: number), Rect(w: number, h: number), Point }
const inputs: Shape[] = [Shape.Circle(1), Shape.Circle(5), Shape.Rect(4, 2), Shape.Rect(1, 3), Shape.Point];
function* probe(input: Shape): Generator<unknown, unknown, Shape> {
  using res = resource("res");
  const sent = yield match (note("operand", input)) { Circle(r) if note("guard big", r > 2) => note("big", r), Circle(r) => note("small", r), Rect(w, h) if note("guard wide", w > h) => note("wide", w), Rect(w, h) => note("tall", h), Point => note("point", 0) };
  return sent;
}
await drive("yieldOperand", probe, inputs);
