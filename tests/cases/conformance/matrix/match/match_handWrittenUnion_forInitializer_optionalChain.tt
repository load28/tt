import { note, box, drive } from "./harness.js";
type Event = { kind: "Click"; x: number } | { kind: "Key"; key: string };
const inputs: Event[] = [{ kind: "Click", x: 3 }, { kind: "Key", key: "k" }];
function probe(input: Event) {
  const collected: unknown[] = [];
  for (let item = match (box(input)?.inner.value!) { Click(x) => note("click", x), Key(key) => note("key", key) }, round = 0; round < 1; round++) {
    collected.push(item);
  }
  return collected;
}
await drive("forInitializer", probe, inputs);
