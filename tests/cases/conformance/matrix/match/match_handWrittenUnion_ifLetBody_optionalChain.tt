type Event = { kind: "Click"; x: number } | { kind: "Key"; key: string };
let t0: any;
const inputs: Event[] = [{ kind: "Click", x: 3 }, { kind: "Key", key: "k" }];
function probe(input: Event) {
  const head = read(note("head", 1));
  if (head.kind === "Ok") {
    const n = head.value;
    return [n, (t0 = box(input)?.inner.value!, t0.kind === "Click" ? note("click", t0.x) : note("key", t0.key))];
