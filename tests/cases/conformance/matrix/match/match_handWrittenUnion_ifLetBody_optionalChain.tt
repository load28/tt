import { note, box, read, drive } from "./harness.js";
type Event = { kind: "Click"; x: number } | { kind: "Key"; key: string };
const inputs: Event[] = [{ kind: "Click", x: 3 }, { kind: "Key", key: "k" }];
function probe(input: Event) {
  if let Ok(value: n) = read(note("head", 1)) {
    return [n, match (box(input)?.inner.value!) { Click(x) => note("click", x), Key(key) => note("key", key) }];
  }
  return null;
}
await drive("ifLetBody", probe, inputs);
