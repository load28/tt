import { note, callee, drive } from "./harness.js";
type Event = { kind: "Click"; x: number } | { kind: "Key"; key: string };
const inputs: Event[] = [{ kind: "Click", x: 3 }, { kind: "Key", key: "k" }];
function* probe(input: Event): Generator<unknown, unknown, Event> {
  const ran = callee(true)?.(match ((yield input)) { Click(x) => note("click", x), Key(key) => note("key", key) });
  const skipped = callee(false)?.(match ((yield input)) { Click(x) => note("click", x), Key(key) => note("key", key) });
  return [ran, skipped];
}
await drive("optionalCall", probe, inputs);
