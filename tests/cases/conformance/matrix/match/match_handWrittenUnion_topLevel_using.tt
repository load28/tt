import { text, note, resource, report } from "./harness.js";
type Event = { kind: "Click"; x: number } | { kind: "Key"; key: string };
const inputs: Event[] = [{ kind: "Click", x: 3 }, { kind: "Key", key: "k" }];
let input: Event = inputs[0]!;
using res = resource("res");
const top0 = match (note("operand", input)) { Click(x) => note("click", x), Key(key) => note("key", key) };
report("topLevel", input, text(top0));
input = inputs[1]!;
const top1 = match (note("operand", input)) { Click(x) => note("click", x), Key(key) => note("key", key) };
report("topLevel", input, text(top1));
