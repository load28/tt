import { note, drive } from "./harness.js";
const inputs: unknown[] = [new RangeError("range"), new TypeError("type"), new Error("plain"), "text"];
function* probe(input: unknown): Generator<unknown, unknown, unknown> {
  const collected: unknown[] = [];
  for (const item of [match ((yield input)) { is RangeError { message } => note("range", message), is TypeError | is SyntaxError => note("type", 1), is Error { message: detail } => note("error", detail), _ => note("other", null) }]) {
    collected.push(item);
  }
  return collected;
}
await drive("forOfHead", probe, inputs);
