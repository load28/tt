import { note, box, drive } from "./harness.js";
const inputs: unknown[] = [new RangeError("range"), new TypeError("type"), new Error("plain"), "text"];
function probe(input: unknown) {
  const before = note("before", 1), value = match (box(input)?.inner.value!) { is RangeError { message } => note("range", message), is TypeError | is SyntaxError => note("type", 1), is Error { message: detail } => note("error", detail), _ => note("other", null) };
  return [before, value];
}
await drive("laterDeclarator", probe, inputs);
