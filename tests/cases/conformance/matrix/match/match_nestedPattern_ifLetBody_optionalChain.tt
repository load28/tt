import { note, box, read, drive } from "./harness.js";
type Maybe = { kind: "Some"; value: number } | { kind: "None" };
const Maybe = {
  Some: (value: number): Maybe => ({ kind: "Some" as const, value }),
  None: { kind: "None" } as Maybe,
};
type Outcome = { kind: "Done"; value: Maybe } | { kind: "Failed"; error: string };
const Outcome = {
  Done: (value: Maybe): Outcome => ({ kind: "Done" as const, value }),
  Failed: (error: string): Outcome => ({ kind: "Failed" as const, error }),
};
let t0: any;
const inputs: Outcome[] = [Outcome.Done(Maybe.Some(7)), Outcome.Done(Maybe.None), Outcome.Failed("lost")];
function probe(input: Outcome) {
  const head = read(note("head", 1));
  if (head.kind === "Ok") {
    const n = head.value;
    return [n, (t0 = box(input)?.inner.value!, t0.kind === "Done" && t0.value.kind === "Some" ? note("some", t0.value.value) : t0.kind === "Done" && t0.value.kind === "None" ? note("none", 0) : note("failed", t0.error))];
  }
  return null;
}
await drive("ifLetBody", probe, inputs);
