import { note, drive } from "./harness.js";
let t0: any;
const inputs: number[] = [200, 201, 404, 500, 7];
function* probe(input: number): Generator<unknown, unknown, number> {
  const target = { value: note("initial", 0) as unknown };
  note("target", target).value = (t0 = (yield input), t0 === 200 || t0 === 201 ? note("success", true) : t0 === 404 ? note("missing", false) : t0 === 500 && note("guard", true) ? note("server", false) : note("other", null));
  return target.value;
}
await drive("assignment", probe, inputs);
