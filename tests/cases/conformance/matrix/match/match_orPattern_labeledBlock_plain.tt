import { text, note, flip, drive } from "./harness.js";
variant Token { Num(value: number), Neg(value: number), Word(text: string), End }
const inputs: Token[] = [Token.Num(4), Token.Neg(-3), Token.Word("hi"), Token.End];
function probe(input: Token) {
  let collected: unknown = "none";
  found: {
    collected = match (note("operand", input)) { Num(value) | Neg(value) => note("number", value), Word(text) => note("word", text), End => note("end", "") };
    if (flip()) break found;
    collected = [collected];
  }
  return collected;
}
await drive("labeledBlock", probe, inputs);
