import { note, drive } from "./harness.js";
const inputs: string[] = ["north", "south", "east", "up"];
function probe(input: string) {
  try {
    const target = { total: note("initial", "start:") };
    note("target", target).total += match (note("operand", input)) { "north" => note("n", 1), "south" | "east" => note("se", 2), _ => note("other", 0) };
    return target.total;
  } finally {
    note("finally", 0);
  }
}
await drive("compoundAssignment", probe, inputs);
