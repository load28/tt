import { note, box, read, drive } from "./harness.js";
const inputs: string[] = ["north", "south", "east", "up"];
function probe(input: string) {
  class Holder {
    tag = "holder";
    read(input: string) {
      note("this", this.tag);
      return match (box(input)?.inner.value!) { "north" => note("n", 1), "south" | "east" => note("se", 2), _ => note("other", 0) };
    }
  }
  return new Holder().read(input);
}
await drive("method", probe, inputs);
