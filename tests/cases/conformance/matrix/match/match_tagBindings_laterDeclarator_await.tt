import { note, later, drive } from "./harness.js";
type Shape = { kind: "Circle"; r: number } | { kind: "Rect"; w: number; h: number } | { kind: "Point" };
const Shape = {
  Circle: (r: number): Shape => ({ kind: "Circle" as const, r }),
  Rect: (w: number, h: number): Shape => ({ kind: "Rect" as const, w, h }),
  Point: { kind: "Point" } as Shape,
};
let t0: any;
const inputs: Shape[] = [Shape.Circle(2), Shape.Rect(3, 4), Shape.Point];
async function probe(input: Shape) {
  const before = note("before", 1), value = (t0 = await later(input), t0.kind === "Circle" ? note("circle", t0.r * 2) : t0.kind === "Rect" ? note("rect", t0.w * t0.h) : note("point", 0));
  return [before, value];
}
await drive("laterDeclarator", probe, inputs);
