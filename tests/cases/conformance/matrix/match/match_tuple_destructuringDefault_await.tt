import { note, later, drive } from "./harness.js";
variant Shape { Circle(r: number), Rect(w: number, h: number), Point }
variant Speed { Fast, Slow }
const inputs: Shape[] = [Shape.Circle(2), Shape.Rect(3, 4), Shape.Point];
async function probe(input: Shape) {
  const { value = match (await later(input), note<Speed>("second", Speed.Fast)) { (Circle(r), Fast) => note("fast circle", r), (Rect(w), _) => note("rect", w), (_, Slow) => note("slow", 0), (Circle | Point, _) => note("rest", -1) } }: { value?: unknown } = note("source", {});
  return value;
}
await drive("destructuringDefault", probe, inputs);
