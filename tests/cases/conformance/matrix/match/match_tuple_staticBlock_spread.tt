import { note, first, drive } from "./harness.js";
variant Shape { Circle(r: number), Rect(w: number, h: number), Point }
variant Speed { Fast, Slow }
const inputs: Shape[] = [Shape.Circle(2), Shape.Rect(3, 4), Shape.Point];
function probe(input: Shape) {
  class Holder {
    static field: unknown;
    static {
      Holder.field = match (first(...[input]), note<Speed>("second", Speed.Fast)) { (Circle(r), Fast) => note("fast circle", r), (Rect(w), _) => note("rect", w), (_, Slow) => note("slow", 0), (Circle | Point, _) => note("rest", -1) };
    }
  }
  return Holder.field;
}
await drive("staticBlock", probe, inputs);
