    static field: unknown;
    static {
      Holder.field = (t0 = first(...[input]), t1 = note<Speed>("second", Speed.Fast), t0.kind === "Circle" && t1.kind === "Fast" ? note("fast circle", t0.r) : t0.kind === "Rect" ? note("rect", t0.w) : t1.kind === "Slow" ? note("slow", 0) : note("rest", -1));
