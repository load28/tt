type Token = { kind: "Num"; value: number } | { kind: "Neg"; value: number } | { kind: "Word"; text: string } | { kind: "End" };
const Token = {
  Num: (value: number): Token => ({ kind: "Num" as const, value }),
  Neg: (value: number): Token => ({ kind: "Neg" as const, value }),
  Word: (text: string): Token => ({ kind: "Word" as const, text }),
  End: { kind: "End" } as Token,
};
let t0: any, t1: any, t2: any, t3: any;
const inputs: Token[] = [Token.Num(4), Token.Neg(-3), Token.Word("hi"), Token.End];
let input: Token = inputs[0]!;
const top0 = (t0 = first(...[input]), t0.kind === "Word" ? note("word", t0.text.length) : note("other", -1));
report("topLevel", input, text(top0));
