import { text, note, box, drive } from "./harness.js";
variant Token { Num(value: number), Neg(value: number), Word(text: string), End }
const inputs: Token[] = [Token.Num(4), Token.Neg(-3), Token.Word("hi"), Token.End];
function probe(input: Token) {
  let rounds = 0;
  while (rounds < 1 && match (box(input)?.inner.value!) { Word(text) => note("word", text.length), _ => note("other", -1) }) {
    rounds++;
  }
  return rounds;
}
await drive("whileTest", probe, inputs);
