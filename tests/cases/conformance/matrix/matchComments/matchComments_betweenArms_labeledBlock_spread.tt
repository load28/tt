// @filename: harness.ts
export const out: string[] = [];
export function text(value: unknown): string {
  if (typeof value === "bigint") return `${value}n`;
  if (typeof value === "function") return "function";
  if (value === undefined) return "undefined";
  return JSON.stringify(value);
}
export function note<T>(label: string, value: T): T {
  out.push(`${label} ${text(value)}`);
  return value;
}
let flips = 0;
export function flip(): boolean {
  return note("flip", flips++ % 2 === 0);
}
export function first<T>(...items: T[]): T {
  return items[0]!;
}
export function report(title: string, input: unknown, shown: string): void {
  console.log(`${title}(${text(input)}) => ${shown} | ${out.join("; ")}`);
  out.length = 0;
}
export async function drive(title: string, probe: (input: any) => unknown, inputs: readonly unknown[]): Promise<void> {
  for (const input of inputs) {
    let shown: string;
    try {
      let value: any = probe(input);
      if (value !== null && typeof value === "object" && typeof value.next === "function" && Symbol.iterator in value) {
        let step = value.next();
        while (!step.done) {
          out.push(`yield ${text(step.value)}`);
          step = value.next(step.value);
        }
        value = step.value;
      }
      if (value instanceof Promise) value = await value;
      if (typeof value === "function") value = value(input);
      shown = text(value);
    } catch (error) {
      shown = `threw ${error instanceof Error ? error.message : text(error)}`;
    }
    report(title, input, shown);
  }
}
// @filename: main.tt
import { note, flip, first, drive } from "./harness.js";
variant Shape { Circle(r: number), Rect(w: number, h: number), Point }
const inputs: Shape[] = [Shape.Circle(2), Shape.Rect(3, 4), Shape.Point];
function probe(input: Shape) {
  let collected: unknown = "none";
  found: {
    collected = match (first(...[input])) {
      // the radius, doubled
      Circle(r) => note("circle", r * 2), // an area next
      Rect(w, h) => note("rect", w * h), /* no area */ Point => note("point", 0)
      // after the last arm
    };
    if (flip()) break found;
    collected = [collected];
  }
  return collected;
}
await drive("labeledBlock", probe, inputs);
// @filename: twin.ts
import { note, flip, first, drive } from "./harness.js";
type Shape = { kind: "Circle"; r: number } | { kind: "Rect"; w: number; h: number } | { kind: "Point" };
const Shape = {
  Circle: (r: number): Shape => ({ kind: "Circle" as const, r }),
  Rect: (w: number, h: number): Shape => ({ kind: "Rect" as const, w, h }),
  Point: { kind: "Point" } as Shape,
};
let t0: any;
const inputs: Shape[] = [Shape.Circle(2), Shape.Rect(3, 4), Shape.Point];
function probe(input: Shape) {
  let collected: unknown = "none";
  found: {
    collected = (t0 = first(...[input]), t0.kind === "Circle" ? note("circle", t0.r * 2) : t0.kind === "Rect" ? note("rect", t0.w * t0.h) : note("point", 0));
    if (flip()) break found;
    collected = [collected];
  }
  return collected;
}
await drive("labeledBlock", probe, inputs);
