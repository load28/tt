import { text, note, later, report } from "./harness.js";
variant Shape { Circle(r: number), Rect(w: number, h: number), Point }
const inputs: Shape[] = [Shape.Circle(2), Shape.Rect(3, 4), Shape.Point];
let input: Shape = inputs[0]!;
const top0 = match (await later(input)) {
  // the radius, doubled
  Circle(r) => note("circle", r * 2), // an area next
  Rect(w, h) => note("rect", w * h), /* no area */ Point => note("point", 0)
  // after the last arm
};
report("topLevel", input, text(top0));
input = inputs[1]!;
const top1 = match (await later(input)) {
  // the radius, doubled
  Circle(r) => note("circle", r * 2), // an area next
  Rect(w, h) => note("rect", w * h), /* no area */ Point => note("point", 0)
  // after the last arm
};
report("topLevel", input, text(top1));
input = inputs[2]!;
const top2 = match (await later(input)) {
  // the radius, doubled
  Circle(r) => note("circle", r * 2), // an area next
  Rect(w, h) => note("rect", w * h), /* no area */ Point => note("point", 0)
  // after the last arm
};
report("topLevel", input, text(top2));
