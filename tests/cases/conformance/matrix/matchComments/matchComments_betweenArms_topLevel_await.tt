import { text, note, later, report } from "./harness.js";
type Shape = { kind: "Circle"; r: number } | { kind: "Rect"; w: number; h: number } | { kind: "Point" };
const Shape = {
  Circle: (r: number): Shape => ({ kind: "Circle" as const, r }),
  Rect: (w: number, h: number): Shape => ({ kind: "Rect" as const, w, h }),
  Point: { kind: "Point" } as Shape,
};
let t0: any, t1: any, t2: any;
const inputs: Shape[] = [Shape.Circle(2), Shape.Rect(3, 4), Shape.Point];
let input: Shape = inputs[0]!;
const top0 = (t0 = await later(input), t0.kind === "Circle" ? note("circle", t0.r * 2) : t0.kind === "Rect" ? note("rect", t0.w * t0.h) : note("point", 0));
report("topLevel", input, text(top0));
input = inputs[1]!;
const top1 = (t1 = await later(input), t1.kind === "Circle" ? note("circle", t1.r * 2) : t1.kind === "Rect" ? note("rect", t1.w * t1.h) : note("point", 0));
report("topLevel", input, text(top1));
input = inputs[2]!;
const top2 = (t2 = await later(input), t2.kind === "Circle" ? note("circle", t2.r * 2) : t2.kind === "Rect" ? note("rect", t2.w * t2.h) : note("point", 0));
report("topLevel", input, text(top2));
