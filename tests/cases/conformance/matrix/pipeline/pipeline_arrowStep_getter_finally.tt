import { note, drive } from "./harness.js";
const inputs: number[] = [8, 9];
function probe(input: number) {
  try {
    const holder = {
      get field() {
        return note("operand", input) |> ((n: number) => note("arrow", n + 1));
      },
    };
    return holder.field;
  } finally {
    note("finally", 0);
  }
}
await drive("getter", probe, inputs);
