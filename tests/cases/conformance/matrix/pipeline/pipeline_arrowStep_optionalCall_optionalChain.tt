import { note, callee, box, drive } from "./harness.js";
const inputs: number[] = [8, 9];
function probe(input: number) {
  const ran = callee(true)?.(box(input)?.inner.value! |> ((n: number) => note("arrow", n + 1)));
  const skipped = callee(false)?.(box(input)?.inner.value! |> ((n: number) => note("arrow", n + 1)));
  return [ran, skipped];
}
await drive("optionalCall", probe, inputs);
