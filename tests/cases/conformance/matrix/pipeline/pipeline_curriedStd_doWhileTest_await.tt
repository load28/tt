import { note, later, drive } from "./harness.js";
import * as Option from "@tt/std/option";
const inputs: number[] = [5, 0];
async function probe(input: number) {
  let rounds = 0;
  do {
    rounds++;
  } while (rounds < 2 && (Option.fromNullable(await later(input) || null) |> Option.mapP((n: number) => note("map", n * 3)) |> Option.unwrapOrP(-1)));
  return rounds;
}
await drive("doWhileTest", probe, inputs);
