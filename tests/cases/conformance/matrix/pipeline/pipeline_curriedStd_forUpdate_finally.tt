import { note, drive } from "./harness.js";
import * as Option from "@tt/std/option";
const inputs: number[] = [5, 0];
function probe(input: number) {
  try {
    let last: unknown = null;
    for (let round = 0; round < 1; round++, last = Option.fromNullable(note("operand", input) || null) |> Option.mapP((n: number) => note("map", n * 3)) |> Option.unwrapOrP(-1)) {
      note("body", round);
    }
    return last;
  } finally {
    note("finally", 0);
  }
}
await drive("forUpdate", probe, inputs);
