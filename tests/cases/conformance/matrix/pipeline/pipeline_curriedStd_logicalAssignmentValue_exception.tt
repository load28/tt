import { note, flip, risky, drive } from "./harness.js";
import * as Option from "@tt/std/option";
const inputs: number[] = [5, 0];
function probe(input: number) {
  try {
    let slot: unknown = flip() ? null : "kept";
    return [(slot ??= Option.fromNullable(risky(input) || null) |> Option.mapP((n: number) => note("map", n * 3)) |> Option.unwrapOrP(-1)), slot];
  } catch (error) {
    return note("caught", (error as Error).message);
  }
}
await drive("logicalAssignmentValue", probe, inputs);
