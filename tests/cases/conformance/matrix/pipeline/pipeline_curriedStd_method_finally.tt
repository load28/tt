import * as Option from "@tt/std/option";
const inputs: number[] = [5, 0];
function probe(input: number) {
  try {
    class Holder {
      tag = "holder";
      read(input: number) {
        note("this", this.tag);
        return Option.fromNullable(note("operand", input) || null) |> Option.mapP((n: number) => note("map", n * 3)) |> Option.unwrapOrP(-1);
      }
    }
    return new Holder().read(input);
  } finally {
    note("finally", 0);
  }
}
await drive("method", probe, inputs);
