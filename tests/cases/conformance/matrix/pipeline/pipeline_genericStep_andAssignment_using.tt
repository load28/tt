import { note, flip, double, keep, resource, drive } from "./harness.js";
const inputs: number[] = [6, -2];
function probe(input: number) {
  using res = resource("res");
  const target = { value: (flip() ? 0 : "kept") as unknown };
  note("target", target).value &&= note("operand", input) |> keep |> double;
  return target.value;
}
await drive("andAssignment", probe, inputs);
