import { note, first, double, keep, drive } from "./harness.js";
const inputs: number[] = [6, -2];
function probe(input: number) {
  let collected: unknown = "none";
  switch (note("discriminant", 0) as unknown) {
    case first(...[input]) |> keep |> double:
    collected = "matched";
    break;
    default:
    collected = "default";
  }
  return collected;
}
await drive("switchCaseTest", probe, inputs);
