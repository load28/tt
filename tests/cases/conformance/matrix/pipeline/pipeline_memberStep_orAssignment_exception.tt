import { note, flip, risky, tools, drive } from "./harness.js";
let t0: any;
const inputs: number[] = [2, 6];
function probe(input: number) {
  try {
    const target = { value: (flip() ? 0 : "kept") as unknown };
    note("target", target).value ||= (t0 = risky(input), note("receiver", tools).twice(t0));
    return target.value;
  } catch (error) {
    return note("caught", (error as Error).message);
  }
}
await drive("orAssignment", probe, inputs);
