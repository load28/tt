import { flip, double, lookup, drive } from "./harness.js";
const inputs: number[] = [10, 20];
function* probe(input: number): Generator<unknown, unknown, number> {
  const value = (yield input) |> lookup(flip()) ?? double;
  return value;
}
await drive("declarationInitializer", probe, inputs);
