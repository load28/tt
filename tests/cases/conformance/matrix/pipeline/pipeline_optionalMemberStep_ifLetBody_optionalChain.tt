import { note, flip, box, maybe, read, drive } from "./harness.js";
const inputs: number[] = [3, 4, 5];
function probe(input: number) {
  if let Ok(value: n) = read(note("head", 1)) {
    return [n, box(input)?.inner.value! |> maybe(flip())?.twice];
  }
  return null;
}
await drive("ifLetBody", probe, inputs);
