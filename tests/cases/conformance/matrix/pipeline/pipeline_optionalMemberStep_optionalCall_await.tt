import { later, flip, callee, maybe, drive } from "./harness.js";
const inputs: number[] = [3, 4, 5];
async function probe(input: number) {
  const ran = callee(true)?.(await later(input) |> maybe(flip())?.twice);
  const skipped = callee(false)?.(await later(input) |> maybe(flip())?.twice);
  return [ran, skipped];
}
await drive("optionalCall", probe, inputs);
