import { text, later, flip, maybe, report } from "./harness.js";
const inputs: number[] = [3, 4, 5];
let input: number = inputs[0]!;
const top0 = await later(input) |> maybe(flip())?.twice;
report("topLevel", input, text(top0));
input = inputs[1]!;
const top1 = await later(input) |> maybe(flip())?.twice;
report("topLevel", input, text(top1));
input = inputs[2]!;
const top2 = await later(input) |> maybe(flip())?.twice;
report("topLevel", input, text(top2));
