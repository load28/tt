import { note, flip, maybe, drive } from "./harness.js";
const inputs: number[] = [3, 4, 5];
function probe(input: number) {
  try {
    let rounds = 0;
    while (rounds < 1 && (note("operand", input) |> maybe(flip())?.twice)) {
      rounds++;
    }
    return rounds;
  } finally {
    note("finally", 0);
  }
}
await drive("whileTest", probe, inputs);
