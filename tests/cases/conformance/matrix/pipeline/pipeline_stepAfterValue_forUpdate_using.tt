import { note, adder, resource, drive } from "./harness.js";
const inputs: number[] = [4, -1];
function probe(input: number) {
  using res = resource("res");
  let last: unknown = null;
  for (let round = 0; round < 1; round++, last = note("operand", input) |> adder(note("step", 3))) {
    note("body", round);
  }
  return last;
}
await drive("forUpdate", probe, inputs);
