import { callee, box, read, drive } from "./harness.js";
import * as Result from "@tt/std/result";
const inputs: number[] = [3, -2];
function probe(input: number) {
  const ran = callee(true)?.(try read(box(input)?.inner.value!) * 10);
  const skipped = callee(false)?.(try read(box(input)?.inner.value!) * 10);
  return Result.Ok([ran, skipped]);
}
await drive("optionalCall", probe, inputs);
