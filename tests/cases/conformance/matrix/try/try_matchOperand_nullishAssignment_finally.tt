import { note, flip, read, drive } from "./harness.js";
import * as Result from "@tt/std/result";
const inputs: number[] = [1, 2, -3];
function probe(input: number) {
  try {
    const target = { value: (flip() ? null : "kept") as unknown };
    note("target", target).value ??= try match (note("operand", input)) { 1 => read(note("one", 10)), _ => read(note("other", -10)) };
    return Result.Ok(target.value);
  } finally {
    note("finally", 0);
  }
}
await drive("nullishAssignment", probe, inputs);
