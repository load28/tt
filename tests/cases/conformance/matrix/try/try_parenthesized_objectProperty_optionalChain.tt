import { note, flip, box, read, drive } from "./harness.js";
import * as Result from "@tt/std/result";
const inputs: number[] = [6, -6];
function probe(input: number) {
  return Result.Ok({ a: note("a", 1), value: try (flip() ? read(box(input)?.inner.value!) : read(note("fallback", -9))), c: note("c", 3) });
}
await drive("objectProperty", probe, inputs);
