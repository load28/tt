import { text, note, risky, ok, read, Propagate, unwrap, caught, drive, element, Fragment } from "./harness.js";
const inputs: number[] = [2, -1];
function probe(input: number) {
  try {
    function Card(props: { input: number }) {
      try {
        const input = props.input;
        unwrap(read(risky(input)));
        return ok(<p>{text("checked")}</p>);
      } catch (error) {
