import { note, later, read, drive } from "./harness.js";
import * as Result from "@tt/std/result";
const inputs: number[] = [2, -1];
async function probe(input: number) {
  const block = result {
    const base = try read(note("base", 1));
    try read(await later(input));
    return [base, "checked"];
