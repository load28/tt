import { note, later, ok, read, unwrap, caught, drive } from "./harness.js";
const inputs: number[] = [2, -1];
async function probe(input: number) {
  try {
    const block = (await (async () => {
          try {
            const base = unwrap(read(note("base", 1)));
            unwrap(read(await later(input)));
            return ok([base, "checked"]);
          } catch (error) {
            return caught(error);
          }
      })());
    return ok(block);
  } catch (error) {
    return caught(error);
  }
}
await drive("resultBody", probe, inputs);
