import { note, risky, read, drive } from "./harness.js";
import * as Result from "@tt/std/result";
const inputs: number[] = [2, -1];
function probe(input: number) {
  try {
    let collected: unknown = "none";
    while (note("test", true)) {
      try read(risky(input));
      collected = "checked";
      break;
    }
    return Result.Ok(collected);
  } catch (error) {
    return Result.Ok(note("caught", (error as Error).message));
  }
}
await drive("whileBody", probe, inputs);
// @filename: twin.ts
import { note, risky, ok, read, Propagate, unwrap, caught, drive } from "./harness.js";
const inputs: number[] = [2, -1];
function probe(input: number) {
  try {
    try {
      let collected: unknown = "none";
      while (note("test", true)) {
        unwrap(read(risky(input)));
        collected = "checked";
        break;
      }
      return ok(collected);
    } catch (error) {
      if (error instanceof Propagate) throw error;
      return ok(note("caught", (error as Error).message));
    }
  } catch (error) {
    return caught(error);
  }
}
await drive("whileBody", probe, inputs);
