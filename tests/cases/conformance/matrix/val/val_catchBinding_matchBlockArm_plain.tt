import { note, drive } from "./harness.js";
const inputs: number[] = [3, 8];
function probe(input: number) {
  const value = match (note<boolean>("arm", true)) {
    true => {
      let seen: unknown = null;
      try {
        throw { n: note("operand", input) };
      } catch (val e) {
        seen = note("caught", e);
      }
      return seen;
    },
    false => "other",
  };
  return value;
}
await drive("matchBlockArm", probe, inputs);
