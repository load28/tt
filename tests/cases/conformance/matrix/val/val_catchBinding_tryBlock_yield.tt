import { note, drive } from "./harness.js";
const inputs: number[] = [3, 8];
function* probe(input: number): Generator<unknown, unknown, number> {
  try {
    let seen: unknown = null;
    try {
      throw { n: (yield input) };
    } catch (val e) {
      seen = note("caught", e);
    }
    return seen;
  } catch (error) {
    return "caught";
  }
}
await drive("tryBlock", probe, inputs);
