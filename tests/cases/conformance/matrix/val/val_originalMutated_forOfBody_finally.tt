import { note, drive } from "./harness.js";
const inputs: number[] = [3, 8];
function probe(input: number) {
  try {
    const collected: unknown[] = [];
    for (const round of [0, 1]) {
      note("round", round);
      const original = { n: note("operand", input) };
      val const view = original;
      original.n = note("original", original.n + 10);
      const seen = view.n;
      collected.push(seen);
    }
    return collected;
  } finally {
    note("finally", 0);
  }
}
await drive("forOfBody", probe, inputs);
