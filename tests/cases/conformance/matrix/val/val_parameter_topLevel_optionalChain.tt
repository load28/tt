import { text, note, box, report } from "./harness.js";
const inputs: number[] = [3, 8];
let input: number = inputs[0]!;
function readN(val p: { n: number }) {
  return note("param", p.n);
}
const seen = readN({ n: box(input)?.inner.value! });
report("topLevel", input, text(seen));
