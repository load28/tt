import { note, box, drive } from "./harness.js";
const inputs: number[] = [3, 8];
function probe(input: number) {
  switch (note("discriminant", 1)) {
    case 1: {
      const show = (val p: { n: number }) => note("show", p.n);
      val const cfg = { n: box(input)?.inner.value! };
      const seen = show(cfg);
      return seen;
    }
    default:
    return "default";
  }
}
await drive("switchClause", probe, inputs);
