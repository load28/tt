import { text, note, resource, report } from "./harness.js";
const inputs: number[] = [4, 9];
let input: number = inputs[0]!;
using res = resource("res");
type Tree<T> = { kind: "Leaf"; value: T } | { kind: "Node"; left: Tree<T>; right: Tree<T> };
const Tree = {
  Leaf: <T>(value: T): Tree<T> => ({ kind: "Leaf" as const, value }),
  Node: <T>(left: Tree<T>, right: Tree<T>): Tree<T> => ({ kind: "Node" as const, left, right }),
