import { note, resource, drive } from "./harness.js";
const inputs: number[] = [4, 9];
function probe(input: number) {
  using res = resource("res");
  const inner = (input: number) => {
    type Op = { kind: "Add"; n: number } | { kind: "Neg" };
    const Op = {
      Add: (n: number): Op => ({ kind: "Add" as const, n }),
      Neg: { kind: "Neg" } as Op,
    };
    const seen = [Op.Add(note("operand", input)), Op.Neg].map((o) => { const t0 = o; return t0.kind === "Add" ? note("add", t0.n + 1) : note("neg", 0); });
    return seen;
  };
  return inner(input);
}
await drive("arrowBlock", probe, inputs);
