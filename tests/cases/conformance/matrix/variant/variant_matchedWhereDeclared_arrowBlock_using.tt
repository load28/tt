import { note, resource, drive } from "./harness.js";
const inputs: number[] = [4, 9];
function probe(input: number) {
  using res = resource("res");
  const inner = (input: number) => {
    variant Op { Add(n: number), Neg }
    const seen = [Op.Add(note("operand", input)), Op.Neg].map((o) => match (o) { Add(n) => note("add", n + 1), Neg => note("neg", 0) });
    return seen;
  };
  return inner(input);
}
await drive("arrowBlock", probe, inputs);
