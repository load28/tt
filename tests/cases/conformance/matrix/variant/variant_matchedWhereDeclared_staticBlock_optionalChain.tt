import { note, box, drive } from "./harness.js";
const inputs: number[] = [4, 9];
function probe(input: number) {
  class Holder {
    static field: unknown = "none";
    static {
      variant Op { Add(n: number), Neg }
      const seen = [Op.Add(box(input)?.inner.value!), Op.Neg].map((o) => match (o) { Add(n) => note("add", n + 1), Neg => note("neg", 0) });
      Holder.field = seen;
    }
  }
  return Holder.field;
}
await drive("staticBlock", probe, inputs);
// @filename: twin.ts
import { note, box, drive } from "./harness.js";
const inputs: number[] = [4, 9];
function probe(input: number) {
  class Holder {
    static field: unknown = "none";
    static {
      type Op = { kind: "Add"; n: number } | { kind: "Neg" };
      const Op = {
        Add: (n: number): Op => ({ kind: "Add" as const, n }),
        Neg: { kind: "Neg" } as Op,
      };
      const seen = [Op.Add(box(input)?.inner.value!), Op.Neg].map((o) => { const t0 = o; return t0.kind === "Add" ? note("add", t0.n + 1) : note("neg", 0); });
      Holder.field = seen;
    }
  }
  return Holder.field;
}
await drive("staticBlock", probe, inputs);
