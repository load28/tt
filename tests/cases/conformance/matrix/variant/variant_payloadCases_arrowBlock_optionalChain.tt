import { box, drive } from "./harness.js";
const inputs: number[] = [4, 9];
function probe(input: number) {
  const inner = (input: number) => {
    variant Shape { Circle(r: number), Rect(w: number, h: number) }
    const seen = [Shape.Circle(box(input)?.inner.value!), Shape.Rect(box(input)?.inner.value!, 2)];
    return seen;
  };
  return inner(input);
}
await drive("arrowBlock", probe, inputs);
