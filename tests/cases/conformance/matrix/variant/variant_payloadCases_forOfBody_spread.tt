import { note, first, drive } from "./harness.js";
const inputs: number[] = [4, 9];
function probe(input: number) {
  const collected: unknown[] = [];
  for (const round of [0, 1]) {
    note("round", round);
    variant Shape { Circle(r: number), Rect(w: number, h: number) }
    const seen = [Shape.Circle(first(...[input])), Shape.Rect(first(...[input]), 2)];
    collected.push(seen);
  }
  return collected;
}
await drive("forOfBody", probe, inputs);
