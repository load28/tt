import { note, risky, drive } from "./harness.js";
const inputs: number[] = [4, 9];
function probe(input: number) {
  try {
    class Holder {
      static field: unknown = "none";
      static {
        type Shape = { kind: "Circle"; r: number } | { kind: "Rect"; w: number; h: number };
        const Shape = {
          Circle: (r: number): Shape => ({ kind: "Circle" as const, r }),
          Rect: (w: number, h: number): Shape => ({ kind: "Rect" as const, w, h }),
        };
        const seen = [Shape.Circle(risky(input)), Shape.Rect(risky(input), 2)];
        Holder.field = seen;
      }
    }
    return Holder.field;
  } catch (error) {
    return note("caught", (error as Error).message);
  }
}
await drive("staticBlock", probe, inputs);
