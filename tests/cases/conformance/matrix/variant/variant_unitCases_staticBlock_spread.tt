import { note, first, drive } from "./harness.js";
const inputs: number[] = [4, 9];
function probe(input: number) {
  class Holder {
    static field: unknown = "none";
    static {
      variant Dir { North, South }
      const seen = [Dir.North, Dir.South, note("operand", first(...[input]))];
      Holder.field = seen;
    }
  }
  return Holder.field;
}
await drive("staticBlock", probe, inputs);
// @filename: twin.ts
import { note, first, drive } from "./harness.js";
const inputs: number[] = [4, 9];
function probe(input: number) {
  class Holder {
    static field: unknown = "none";
    static {
      type Dir = { kind: "North" } | { kind: "South" };
      const Dir = {
        North: { kind: "North" } as Dir,
        South: { kind: "South" } as Dir,
      };
      const seen = [Dir.North, Dir.South, note("operand", first(...[input]))];
      Holder.field = seen;
    }
  }
  return Holder.field;
}
await drive("staticBlock", probe, inputs);
