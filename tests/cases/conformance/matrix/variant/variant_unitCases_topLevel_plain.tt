import { text, note, report } from "./harness.js";
const inputs: number[] = [4, 9];
let input: number = inputs[0]!;
variant Dir { North, South }
const seen = [Dir.North, Dir.South, note("operand", note("operand", input))];
report("topLevel", input, text(seen));
