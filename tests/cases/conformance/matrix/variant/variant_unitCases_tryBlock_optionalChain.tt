import { note, box, drive } from "./harness.js";
const inputs: number[] = [4, 9];
function probe(input: number) {
  try {
    type Dir = { kind: "North" } | { kind: "South" };
    const Dir = {
      North: { kind: "North" } as Dir,
      South: { kind: "South" } as Dir,
    };
    const seen = [Dir.North, Dir.South, note("operand", box(input)?.inner.value!)];
    return seen;
  } catch (error) {
    return "caught";
  }
}
await drive("tryBlock", probe, inputs);
