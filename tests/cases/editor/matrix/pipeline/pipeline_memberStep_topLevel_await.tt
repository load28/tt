import { text, note, later, tools, report } from "./harness.js";
const inputs: number[] = [2, 6];
let input: number = inputs[0]!;
const top0 = await later(/*operand*/input) |> note("receiver", /*use*/tools)./*member*/twice;
report("topLevel", input, text(top0));
input = inputs[1]!;
const top1 = await later(input) |> note("receiver", tools).twice;
report("topLevel", input, text(top1));
