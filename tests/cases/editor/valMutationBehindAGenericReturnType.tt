// @diagnostics: *
// @expectDiagnostic: val-mutation
export variant OrderState { Draft, Submitted(at: string) }
export variant Result<T, E> { Ok(value: T), Err(error: E) }
export type Order = { customer: string; state: OrderState; lines: string[] };
export function submit(val order: Order): Result<Order, string> {
  [|order|].customer = '';
  if (order.lines.length === 0) return Result.Err('Add an order line');
  return match (order.state) {
    Draft => Result.Ok({ ...order, state: OrderState.Submitted('2026-10-03') }),
    _ => Result.Err('Only drafts can be submitted'),
  };
}
