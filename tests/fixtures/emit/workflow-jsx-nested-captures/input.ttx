declare namespace JSX { interface IntrinsicElements { p: {children?:unknown} } }
declare const items:{price:number;quantity:number}[];declare const ready:boolean;
const view=match(ready){true=><p>{items.map(item=><p>{Number(match(item.quantity){0=>0,_=>item.quantity})+Number(match(item.price){0=>0,_=>item.price})}</p>)}</p>,false=><p>Empty</p>};
